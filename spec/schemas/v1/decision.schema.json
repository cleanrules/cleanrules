{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanrules.github.io/schemas/v1/decision.schema.json",
  "title": "cleanrules decision document, format version 1",
  "description": "A decision with every rule's result tree. See spec/json-format.md, sections Decisions and Reading a decision, which are normative. The schema checks shapes, reasons and the children of fields and constants; checks against the rule set (node-by-node match, recomputed truth values, selection, aggregate) need the rule set and are done by readers.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "decision": {
      "$ref": "#/$defs/decision"
    }
  },
  "required": [
    "version",
    "decision"
  ],
  "additionalProperties": false,
  "$defs": {
    "decision": {
      "type": "object",
      "properties": {
        "hit_policy": {
          "enum": [
            "first",
            "priority",
            "unique",
            "any",
            "rule_order",
            "collect"
          ]
        },
        "aggregate": {
          "enum": [
            "sum",
            "min",
            "max",
            "count"
          ]
        },
        "logic": {
          "$ref": "ruleset.schema.json#/$defs/ruleset/properties/logic"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleResult"
          }
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "aggregated": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "value.schema.json#/$defs/value"
              }
            }
          ]
        }
      },
      "required": [
        "hit_policy",
        "logic",
        "results",
        "selected"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "aggregate": [
          "aggregated"
        ],
        "aggregated": [
          "aggregate"
        ]
      }
    },
    "ruleResult": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "fired": {
          "type": "boolean"
        },
        "when": {
          "$ref": "#/$defs/result"
        },
        "then": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "required": [
        "rule",
        "fired",
        "when"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "op": {
          "$ref": "condition.schema.json#/$defs/tag"
        },
        "path": {
          "$ref": "condition.schema.json#/$defs/field/properties/path"
        },
        "truth": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "value": {
          "$ref": "value.schema.json#/$defs/value"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "required": [
        "op"
      ],
      "oneOf": [
        {
          "required": [
            "truth"
          ]
        },
        {
          "required": [
            "value"
          ]
        }
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "field"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          },
          "else": {
            "not": {
              "required": [
                "path"
              ]
            }
          }
        },
        {
          "description": "A reason exactly when truth is unknown (null) or value is null.",
          "if": {
            "anyOf": [
              {
                "properties": {
                  "truth": {
                    "const": null
                  }
                },
                "required": [
                  "truth"
                ]
              },
              {
                "properties": {
                  "value": {
                    "const": null
                  }
                },
                "required": [
                  "value"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "description": "A field or const with value has no children; with truth, exactly one.",
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "field",
                  "const"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "if": {
              "required": [
                "value"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "children"
                ]
              }
            },
            "else": {
              "required": [
                "children"
              ],
              "properties": {
                "children": {
                  "maxItems": 1
                }
              }
            }
          }
        }
      ]
    },
    "reason": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "missing_field",
            "null",
            "type_mismatch",
            "unorderable",
            "division_by_zero",
            "int_overflow",
            "nan_result",
            "read_error"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "types": {
          "type": "array",
          "items": {
            "enum": [
              "number",
              "string",
              "boolean",
              "date",
              "naive_datetime",
              "aware_datetime",
              "other"
            ]
          }
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    }
  }
}

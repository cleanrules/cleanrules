{
  "version": 1,
  "bundle": {
    "id": "acme/orders",
    "revision": "1",
    "ruleset": {
      "hit_policy": "first",
      "logic": "boolean",
      "strict": true,
      "rules": [
        {
          "name": "early",
          "when": {
            "op": "and",
            "operands": [
              {
                "op": "lt",
                "left": {
                  "op": "field",
                  "path": [
                    "order",
                    "placed"
                  ]
                },
                "right": {
                  "op": "const",
                  "value": {
                    "$date": "2026-01-01"
                  }
                }
              },
              {
                "op": "between",
                "operand": {
                  "op": "field",
                  "path": [
                    "order",
                    "items",
                    1,
                    "qty"
                  ]
                },
                "low": {
                  "op": "const",
                  "value": 1
                },
                "high": {
                  "op": "const",
                  "value": 10
                },
                "closed": "both"
              }
            ]
          },
          "then": {
            "note": {
              "op": "field",
              "path": [
                "order",
                "$ref"
              ]
            }
          }
        },
        {
          "name": "pricey",
          "when": {
            "op": "and",
            "operands": [
              {
                "op": "ge",
                "left": {
                  "op": "field",
                  "path": [
                    "order",
                    "total"
                  ]
                },
                "right": {
                  "op": "const",
                  "value": {
                    "$decimal": "99.99"
                  }
                }
              },
              {
                "op": "matches",
                "operand": {
                  "op": "field",
                  "path": [
                    "order",
                    "code"
                  ]
                },
                "pattern": "^A"
              }
            ]
          },
          "then": {
            "tier": {
              "op": "const",
              "value": "gold"
            }
          }
        },
        {
          "name": "late",
          "when": {
            "op": "gt",
            "left": {
              "op": "field",
              "path": [
                "order",
                "shipped"
              ]
            },
            "right": {
              "op": "const",
              "value": {
                "$datetime": "2026-01-01T00:00:00Z"
              }
            }
          },
          "then": {
            "late": {
              "op": "const",
              "value": true
            }
          }
        }
      ]
    },
    "ruleset_digest": "sha256:cc98afe71cd2fafabd6c47bb830d53276df9ff257da56382780ce425636af811",
    "engine": {
      "name": "cleanrules",
      "version": "0.0.0",
      "limits": {
        "max_size": 16777216,
        "max_nesting": 1024,
        "max_depth": 256,
        "max_path_segments": 256,
        "max_table_size": 2097152,
        "max_values": 1000000
      }
    },
    "contract": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "$map": {
                    "type": "object",
                    "properties": {
                      "$ref": {
                        "description": "payloads of early (note)"
                      },
                      "code": {
                        "description": "conditions of pricey",
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "items": {
                        "anyOf": [
                          {
                            "type": "array",
                            "prefixItems": [
                              {},
                              {
                                "anyOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "qty": {
                                        "description": "conditions of early",
                                        "anyOf": [
                                          {
                                            "type": "number"
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      }
                                    },
                                    "required": [
                                      "qty"
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            ],
                            "minItems": 2
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "placed": {
                        "description": "conditions of early",
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "$date": {
                                "type": "string",
                                "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                              }
                            },
                            "required": [
                              "$date"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "shipped": {
                        "description": "conditions of late",
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "$datetime": {
                                "type": "string",
                                "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-]((0[0-9]|1[0-7]):[0-5][0-9](:[0-5][0-9])?|18:00(:00)?)(\\[[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*\\])?)$"
                              }
                            },
                            "required": [
                              "$datetime"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "total": {
                        "description": "conditions of pricey",
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "$decimal": {
                                "type": "string",
                                "pattern": "^(-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?|-?inf)$"
                              }
                            },
                            "required": [
                              "$decimal"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "items",
                      "placed",
                      "shipped",
                      "total"
                    ]
                  }
                },
                "required": [
                  "$map"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "order"
        ]
      },
      "output": {
        "keys": [
          "late",
          "note",
          "tier"
        ]
      }
    }
  }
}

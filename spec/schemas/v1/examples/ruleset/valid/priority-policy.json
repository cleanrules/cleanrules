{
  "version": 1,
  "ruleset": {
    "hit_policy": "priority",
    "logic": "boolean",
    "rules": [
      {
        "name": "vip",
        "when": {
          "op": "field",
          "path": [
            "vip"
          ]
        },
        "then": {
          "discount": {
            "op": "const",
            "value": 0.15
          }
        },
        "priority": 10
      },
      {
        "name": "default",
        "when": {
          "op": "const",
          "value": true
        },
        "then": {
          "discount": {
            "op": "const",
            "value": 0.0
          }
        }
      }
    ]
  }
}

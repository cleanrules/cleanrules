{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanrules.github.io/schemas/v1/summary.schema.json",
  "title": "cleanrules summary document, format version 1",
  "description": "The JSON form of summary(), output only. See spec/explain.md, section Summaries, and spec/json-format.md, section Summaries, which are normative.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "required": [
    "version",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "properties": {
        "hit_policy": {
          "$ref": "ruleset.schema.json#/$defs/ruleset/properties/hit_policy"
        },
        "aggregate": {
          "$ref": "ruleset.schema.json#/$defs/ruleset/properties/aggregate"
        },
        "logic": {
          "$ref": "ruleset.schema.json#/$defs/ruleset/properties/logic"
        },
        "strict": {
          "const": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "$ref": "value.schema.json#/$defs/int"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "action": {
                "const": true
              },
              "do": {
                "type": "string",
                "minLength": 1
              }
            },
            "dependentRequired": {
              "do": [
                "action"
              ]
            },
            "required": [
              "name",
              "priority",
              "outputs"
            ],
            "additionalProperties": false
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "condition.schema.json#/$defs/field/properties/path"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "payloads": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rule",
                    "key"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "path",
              "conditions",
              "payloads"
            ],
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "tag",
              "rules"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "hit_policy",
        "logic",
        "rules",
        "fields",
        "outputs",
        "tags"
      ],
      "additionalProperties": false
    }
  }
}

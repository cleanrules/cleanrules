{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanrules.github.io/schemas/v1/decision_table.schema.json",
  "title": "cleanrules decision table document, format version 1",
  "description": "A document holding one decision table. See spec/tables.md, section JSON, which is normative. The text of headers and cells, the number of cells per row, output values and the rules of compiling are checked by readers, not by the schema.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "decision_table": {
      "$ref": "#/$defs/table"
    }
  },
  "required": [
    "version",
    "decision_table"
  ],
  "additionalProperties": false,
  "$defs": {
    "table": {
      "type": "object",
      "properties": {
        "hit_policy": {
          "enum": [
            "first",
            "priority",
            "unique",
            "any",
            "rule_order",
            "output_order",
            "collect"
          ],
          "default": "first"
        },
        "aggregate": {
          "enum": [
            "sum",
            "min",
            "max",
            "count"
          ]
        },
        "logic": {
          "type": "string",
          "default": "boolean"
        },
        "strict": {
          "type": "boolean",
          "default": false
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      },
      "required": [
        "inputs",
        "outputs",
        "rows"
      ],
      "additionalProperties": false,
      "if": {
        "required": [
          "aggregate"
        ]
      },
      "then": {
        "properties": {
          "hit_policy": {
            "const": "collect"
          }
        },
        "required": [
          "hit_policy"
        ]
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "value.schema.json#/$defs/nonNullScalar"
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "priority": {
          "$ref": "value.schema.json#/$defs/int"
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "required": [
        "inputs",
        "outputs"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanrules.github.io/schemas/v1/test_comparison.schema.json",
  "title": "cleanrules test comparison document, format version 1",
  "description": "The comparison of two versions of rules on the same test cases, output only. See spec/comparison.md, which is normative. Within format version 1 new optional keys, new kinds of change, new parts and new relations may be added: consumers ignore the keys they do not know, show a kind or a part they do not know as it is written, and count an item as a change exactly when it has expected; unknown names are written as lowercase words with underscores. Whether a change is expected is a closed set.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "test_comparison": {
      "$ref": "#/$defs/testComparison"
    }
  },
  "required": [
    "version",
    "test_comparison"
  ],
  "additionalProperties": false,
  "$defs": {
    "testComparison": {
      "type": "object",
      "properties": {
        "relation": {
          "description": "The relation of the two sides' runs (spec/comparison.md, Relation): never conflict, which a comparison refuses.",
          "enum": [
            "same_rules_same_engine",
            "same_rules_other_engine",
            "other_rules_same_engine",
            "other_rules_other_engine"
          ]
        },
        "bundles": {
          "description": "The comparison of the two bundles, when both sides are bundles (spec/bundles.md, Comparing bundles).",
          "$ref": "bundle.schema.json#/$defs/comparison"
        },
        "a": {
          "$ref": "#/$defs/side"
        },
        "b": {
          "$ref": "#/$defs/side"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_explained": {
              "description": "The most changes explained.",
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "max_explained"
          ],
          "additionalProperties": false
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "items": {
          "description": "The changes, added cases and removed cases, in comparison order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "required": [
        "relation",
        "a",
        "b",
        "limits",
        "summary",
        "items"
      ],
      "additionalProperties": false
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "side": {
      "description": "One side: the header and summary of its test run, without its results, and the counts of its outcomes.",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "test_run.schema.json#/$defs/testRun/properties/source"
        },
        "hit_policy": {
          "$ref": "test_run.schema.json#/$defs/testRun/properties/hit_policy"
        },
        "aggregate": {
          "$ref": "test_run.schema.json#/$defs/testRun/properties/aggregate"
        },
        "logic": {
          "$ref": "test_run.schema.json#/$defs/testRun/properties/logic"
        },
        "strict": {
          "const": true
        },
        "ruleset_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The rule set digest of the side's rules (spec/json-format.md, Rule set digests)."
        },
        "engine": {
          "$ref": "test_run.schema.json#/$defs/testRun/properties/engine"
        },
        "bundle": {
          "$ref": "test_run.schema.json#/$defs/testRun/properties/bundle"
        },
        "files": {
          "$ref": "test_run.schema.json#/$defs/testRun/properties/files"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_results": {
              "$ref": "#/$defs/count"
            },
            "max_steps": {
              "$ref": "#/$defs/count"
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "$ref": "test_run.schema.json#/$defs/summary"
        },
        "outcomes": {
          "description": "Among the side's cases that ran: decisions (evaluations that gave one), decisions that selected no rule, decisions that left some rule unknown, and evaluations that raised an error (the cases that ran less the decisions).",
          "type": "object",
          "properties": {
            "decisions": {
              "$ref": "#/$defs/count"
            },
            "nothing_selected": {
              "$ref": "#/$defs/count"
            },
            "with_unknown": {
              "$ref": "#/$defs/count"
            },
            "error": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "decisions",
            "nothing_selected",
            "with_unknown",
            "error"
          ],
          "additionalProperties": false
        },
        "statistics": {
          "description": "The side's statistics and coverage, when its runner gathers them (spec/tests.md, Statistics).",
          "$ref": "test_run.schema.json#/$defs/statistics"
        }
      },
      "required": [
        "source",
        "hit_policy",
        "logic",
        "ruleset_digest",
        "engine",
        "files",
        "limits",
        "summary",
        "outcomes"
      ],
      "additionalProperties": false
    },
    "changes": {
      "enum": [
        "same_selection_other_output",
        "other_selection_same_output",
        "other_selection_other_output",
        "other_unknown",
        "error"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "$ref": "#/$defs/count"
        },
        "unchanged": {
          "$ref": "#/$defs/count"
        },
        "changed": {
          "$ref": "#/$defs/count"
        },
        "expected": {
          "$ref": "#/$defs/count"
        },
        "unexpected": {
          "$ref": "#/$defs/count"
        },
        "added": {
          "$ref": "#/$defs/count"
        },
        "removed": {
          "$ref": "#/$defs/count"
        },
        "not_compared": {
          "$ref": "#/$defs/count"
        },
        "partial": {
          "type": "boolean"
        },
        "by_change": {
          "description": "The number of changes of each kind, every kind in the order of spec/comparison.md; a later version may add kinds.",
          "type": "object",
          "properties": {
            "same_selection_other_output": {
              "$ref": "#/$defs/count"
            },
            "other_selection_same_output": {
              "$ref": "#/$defs/count"
            },
            "other_selection_other_output": {
              "$ref": "#/$defs/count"
            },
            "other_unknown": {
              "$ref": "#/$defs/count"
            },
            "error": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "same_selection_other_output",
            "other_selection_same_output",
            "other_selection_other_output",
            "other_unknown",
            "error"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        }
      },
      "required": [
        "total",
        "unchanged",
        "changed",
        "expected",
        "unexpected",
        "added",
        "removed",
        "not_compared",
        "partial",
        "by_change"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "description": "The case's id; absent for a case file that cannot be read.",
          "type": "string",
          "minLength": 1
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/changes"
            },
            {
              "enum": [
                "added",
                "removed"
              ]
            },
            {
              "$ref": "#/$defs/name"
            }
          ]
        },
        "expected": {
          "type": "boolean"
        },
        "differences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/parts"
              },
              {
                "$ref": "#/$defs/name"
              }
            ]
          }
        },
        "unstated": {
          "description": "Why an unexpected change is unexpected: the parts that differ and that side b's expectation does not check, or status when b's result is not passed (spec/comparison.md, Expected changes).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/parts"
              },
              {
                "const": "status"
              },
              {
                "$ref": "#/$defs/name"
              }
            ]
          }
        },
        "a": {
          "$ref": "#/$defs/outcome"
        },
        "b": {
          "$ref": "#/$defs/outcome"
        }
      },
      "required": [
        "change"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "A change: expected or not, with the parts that differ, and why when it is unexpected.",
          "properties": {
            "change": {
              "not": {
                "enum": [
                  "added",
                  "removed"
                ]
              }
            }
          },
          "required": [
            "expected",
            "differences"
          ],
          "anyOf": [
            {
              "required": [
                "a"
              ]
            },
            {
              "required": [
                "b"
              ]
            }
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "expected": {
                    "const": false
                  }
                }
              },
              "then": {
                "required": [
                  "unstated"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "unstated"
                  ]
                }
              }
            }
          ]
        },
        {
          "description": "A case only side b has.",
          "properties": {
            "change": {
              "const": "added"
            }
          },
          "required": [
            "id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "expected"
                ]
              },
              {
                "required": [
                  "differences"
                ]
              },
              {
                "required": [
                  "unstated"
                ]
              },
              {
                "required": [
                  "a"
                ]
              }
            ]
          }
        },
        {
          "description": "A case only side a has.",
          "properties": {
            "change": {
              "const": "removed"
            }
          },
          "required": [
            "id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "expected"
                ]
              },
              {
                "required": [
                  "differences"
                ]
              },
              {
                "required": [
                  "unstated"
                ]
              },
              {
                "required": [
                  "b"
                ]
              }
            ]
          }
        },
        {
          "description": "A kind a later version adds that is not a change: shown as it is written.",
          "properties": {
            "change": {
              "not": {
                "enum": [
                  "same_selection_other_output",
                  "other_selection_same_output",
                  "other_selection_other_output",
                  "other_unknown",
                  "error",
                  "added",
                  "removed"
                ]
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "expected"
                ]
              },
              {
                "required": [
                  "differences"
                ]
              },
              {
                "required": [
                  "unstated"
                ]
              }
            ]
          }
        }
      ]
    },
    "rules": {
      "$ref": "test_run.schema.json#/$defs/rules"
    },
    "output": {
      "$ref": "cases.schema.json#/$defs/output"
    },
    "outcome": {
      "description": "What one side gave the item: the result's status, and the decision or the error.",
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "error"
          ]
        },
        "selected": {
          "$ref": "#/$defs/rules"
        },
        "output": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/output"
            }
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "unknown": {
          "$ref": "#/$defs/rules"
        },
        "error": {
          "$ref": "error.schema.json"
        },
        "explanation_text": {
          "description": "The text of the decision's explanation (spec/explain.md, Text).",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "A decision.",
          "required": [
            "selected",
            "outputs",
            "unknown"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "description": "An error: of the evaluation, whatever the status, or of a case file that cannot be read.",
          "required": [
            "error"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "selected"
                ]
              },
              {
                "required": [
                  "output"
                ]
              },
              {
                "required": [
                  "outputs"
                ]
              },
              {
                "required": [
                  "unknown"
                ]
              },
              {
                "required": [
                  "explanation_text"
                ]
              }
            ]
          }
        }
      ]
    },
    "name": {
      "description": "A name a later version may add: a kind of change, a part or a reason.",
      "type": "string",
      "pattern": "^[a-z][a-z_]*$"
    },
    "parts": {
      "enum": [
        "selected",
        "output",
        "unknown",
        "error"
      ]
    }
  }
}

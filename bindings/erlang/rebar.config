%% The OTP application `cleanrules`: the NIF on the Rust core (crate
%% cleanrules-erlang in native/cleanrules_nif) and its Erlang modules.
{minimum_otp_vsn, "26"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

{deps, []}.

%% scripts/nif.escript puts the NIF library in priv/ before compiling: built
%% with cargo in a checkout of the repository, or downloaded from the release
%% and checked against nif-checksums.config in a package (README.md,
%% "Prebuilt libraries").
{pre_hooks, [{compile, "escript scripts/nif.escript"}]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used, deprecated_function_calls]}.

{dialyzer, [{warnings, [unmatched_returns, error_handling, unknown]}]}.

%% Test suites are not specified function by function.
{profiles, [{test, [{erl_opts, [nowarn_missing_spec]}]}]}.

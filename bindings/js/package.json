{
  "name": "cleanrules",
  "version": "0.0.0",
  "description": "Explainable rules engine for Node.js: one Rust core with the same semantics in every language",
  "keywords": [
    "rules-engine",
    "business-rules",
    "expert-system",
    "validation",
    "explainable"
  ],
  "homepage": "https://cleanrules.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cleanrules/cleanrules.git",
    "directory": "bindings/js"
  },
  "license": "Apache-2.0",
  "author": "Jose L. Salmeron",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "deno": "./index.deno.js",
      "browser": "./index.wasm.js",
      "node": "./index.js",
      "default": "./index.wasm.js"
    },
    "./native": {
      "types": "./native.d.ts",
      "deno": "./native.deno.js",
      "browser": "./native.wasm.js",
      "node": "./native.js",
      "default": "./native.wasm.js"
    },
    "./wasm": {
      "types": "./wasm.d.ts",
      "default": "./wasm.js"
    },
    "./wasm/cleanrules_bg.wasm": "./wasm/cleanrules_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.wasm.js",
    "index.deno.js",
    "index.d.ts",
    "native.js",
    "native.wasm.js",
    "native.deno.js",
    "native.d.ts",
    "wasm.js",
    "wasm.d.ts",
    "binding.cjs",
    "binding.d.ts",
    "lib/",
    "wasm/cleanrules.js",
    "wasm/cleanrules_bg.wasm",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12",
    "deno": ">=2.6"
  },
  "optionalDependencies": {
    "@cleanrules/node-darwin-arm64": "0.0.0",
    "@cleanrules/node-darwin-x64": "0.0.0",
    "@cleanrules/node-linux-arm64-gnu": "0.0.0",
    "@cleanrules/node-linux-arm64-musl": "0.0.0",
    "@cleanrules/node-linux-x64-gnu": "0.0.0",
    "@cleanrules/node-linux-x64-musl": "0.0.0",
    "@cleanrules/node-win32-arm64-msvc": "0.0.0",
    "@cleanrules/node-win32-x64-msvc": "0.0.0"
  },
  "napi": {
    "binaryName": "cleanrules",
    "packageName": "@cleanrules/node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --no-const-enum --js binding.cjs --dts binding.d.ts && node scripts/private-constructors.js",
    "build:release": "napi build --platform --release --no-const-enum --js binding.cjs --dts binding.d.ts && node scripts/private-constructors.js",
    "build:wasm": "node scripts/build-wasm.js",
    "pretest": "npm run build",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=\"lib/**\" --test-coverage-include=\"*.js\" --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"wasm/**\" \"test/**/*.test.js\" && tsc --noEmit -p test/types && tsc --noEmit -p test/types/tsconfig.unchecked.json",
    "pretest:wasm": "npm run build:wasm",
    "test:wasm": "node --env-file=test/wasm.env --test \"test/**/*.test.js\"",
    "test:deno": "deno run --no-prompt test/deno/smoke.js && deno test --no-prompt --env-file=test/wasm.env --allow-read --allow-env --allow-write test/",
    "pretest:deno": "npm run build:wasm",
    "prepack": "node scripts/prepack.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "typescript": "^7.0.2"
  }
}

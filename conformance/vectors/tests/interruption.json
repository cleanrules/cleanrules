    {
      "id": "tests/interruption/max-results",
      "spec": [
        "tests.md#batches-and-interruption",
        "tests.md#test-runs"
      ],
      "description": "max_results stops the run after that many results: a prefix of the full run, partial, with the results not given",
      "given": {
        "kind": "test_run",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "first",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 0
                  }
                }
              },
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                }
              }
            ]
          }
        },
        "files": [
          {
            "path": "one.json",
            "text": "{\"version\": 1, \"cases\": {\"items\": [{\"id\": \"a\", \"input\": {\"x\": 1}}, {\"id\": \"b\", \"input\": {\"x\": 0}}]}}"
          },
          {
            "path": "bad.json",
            "text": "[]"
          },
          {
            "path": "two.json",
            "text": "{\"version\": 1, \"cases\": {\"items\": [{\"id\": \"c\", \"input\": {\"x\": 1}}, {\"id\": \"d\", \"input\": {\"x\": 1}, \"expect\": {\"selected\": []}}]}}"
          }
        ],
        "limits": {
          "max_explained": 0,
          "max_results": 2
        }
      },
      "expect": {
        "test_run": {
          "source": "ruleset",
          "hit_policy": "first",
          "logic": "boolean",
          "engine": {
            "name": "cleanrules",
            "version": "0.0.0-this-engine",
            "limits": {
              "max_size": 16777216,
              "max_nesting": 1024,
              "max_depth": 256,
              "max_path_segments": 256,
              "max_table_size": 2097152,
              "max_values": 1000000
            }
          },
          "files": [
            {
              "path": "one.json",
              "digest": "sha256:6adc5dbab2900a2521ed8ccba88c652a05e2ccd1495912afe5f20e39c5ea9d6e"
            },
            {
              "path": "bad.json",
              "digest": "sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"
            },
            {
              "path": "two.json",
              "digest": "sha256:2235bf1d3433e68ca4ad14a004cc223deb43d1ac500f6690cd80fdffa27c6bd1"
            }
          ],
          "limits": {
            "max_explained": 0,
            "max_results": 2
          },
          "summary": {
            "total": 2,
            "passed": 2,
            "failed": 0,
            "error": 0,
            "partial": true,
            "interrupted": {
              "reason": "max_results",
              "remaining": 3
            }
          },
          "results": [
            {
              "path": "one.json",
              "id": "a",
              "status": "passed"
            },
            {
              "path": "one.json",
              "id": "b",
              "status": "passed"
            }
          ]

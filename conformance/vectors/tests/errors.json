{
  "version": 1,
  "area": "tests",
  "vectors": [
    {
      "id": "tests/errors/unexpected",
      "spec": [
        "tests.md#matching",
        "tests.md#running-cases",
        "tests.md#test-runs"
      ],
      "description": "evaluation raised an error the case does not expect: the result is error, with the error, and the run goes on",
      "given": {
        "kind": "test_run",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "unique",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "then": {
                  "v": {
                    "op": "const",
                    "value": 1
                  }
                }
              },
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 2
                  }
                },
                "then": {
                  "v": {
                    "op": "const",
                    "value": 2
                  }
                }
              }
            ],
            "strict": true
          }
        },
        "cases": {
          "version": 1,
          "cases": {
            "items": [
              {
                "id": "missing",
                "input": {},
                "expect": {
                  "selected": []
                }
              },
              {
                "id": "next",
                "input": {
                  "x": 2
                },
                "expect": {
                  "selected": [
                    "a"
                  ]
                }
              }
            ]
          }
        },
        "limits": {
          "max_explained": 0
        }
      },
      "expect": {
        "test_run": {
          "source": "ruleset",
          "hit_policy": "unique",
          "logic": "boolean",
          "strict": true,
          "engine": {
            "name": "cleanrules",
            "version": "0.0.0-this-engine",
            "limits": {
              "max_size": 16777216,
              "max_nesting": 1024,
              "max_depth": 256,
              "max_path_segments": 256,
              "max_table_size": 2097152,
              "max_values": 1000000
            }
          },
          "files": [
            {}
          ],
          "limits": {
            "max_explained": 0
          },
          "summary": {
            "total": 2,
            "passed": 1,
            "failed": 0,
            "error": 1,
            "partial": false
          },
          "results": [
            {
              "id": "missing",
              "status": "error",
              "error": {
                "code": "missing_field",
                "rule": "a",
                "path": [
                  "x"
                ]
              }
            },
            {
              "id": "next",
              "status": "passed"
            }
          ]
        }
      }
    },

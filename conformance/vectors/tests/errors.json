          "results": [
            {
              "id": "missing-field",
              "status": "passed"
            },
            {
              "id": "both-fire",
              "status": "passed"
            },
            {
              "id": "other-code",
              "status": "failed",
              "mismatches": [
                {
                  "key": "error",
                  "expected": {
                    "code": "type_mismatch"
                  },
                  "actual": {
                    "code": "missing_field",
                    "rule": "a",
                    "path": [
                      "x"
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    },

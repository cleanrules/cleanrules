          "files": [
            {
              "path": "cases/good.json",
              "digest": "sha256:48dbc7a42e9834a0cc6762d5636be1f6310567a59fd39384ae9f47ed79da63c5"
            },
            {
              "path": "cases/other.json",
              "digest": "sha256:2b2f52a4ea042f77dbec96dfee1db0cef5503a2fb3849f2997e92d017f24a697"
            }
          ],
          "limits": {
            "max_explained": 0
          },
          "summary": {
            "total": 2,
            "passed": 1,
            "failed": 0,
            "error": 1,
            "partial": false
          },
          "results": [
            {
              "path": "cases/good.json",
              "id": "vip",
              "status": "passed"

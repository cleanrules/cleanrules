{
  "version": 1,
  "area": "tests",
  "vectors": [
    {
      "id": "tests/bundles/case-files",
      "spec": [
        "tests.md#case-files-of-a-bundle",
        "tests.md#running-cases",
        "tests.md#test-runs"
      ],
      "description": "a bundle's case files run in its order, each checked against its digest and its cases named by path and id; asked for, the run gives the rule set digest",
      "given": {
        "kind": "test_run",
        "document": {
          "version": 1,
          "bundle": {
            "id": "acme/discounts",
            "revision": "1",
            "decision_table": {
              "hit_policy": "first",
              "logic": "boolean",
              "inputs": [
                "customer.years",
                "order.total"
              ],
              "outputs": [
                {
                  "name": "discount"
                },
                {
                  "name": "label"
                }
              ],
              "rows": [
                {
                  "name": "vip",
                  "inputs": [
                    "> 5",
                    "> 1000"
                  ],
                  "outputs": [
                    "0.15",
                    "'VIP'"
                  ]
                },
                {
                  "name": "loyal",
                  "inputs": [
                    "> 2",
                    "-"
                  ],
                  "outputs": [
                    "0.05",
                    "'loyal'"
                  ]
                }
              ]
            },
            "ruleset_digest": "sha256:ac5face379ffdf3fd8015e84ec1f5c71d371113016da6fcad6320d7894b29ee3",
            "engine": {
              "name": "cleanrules",
              "version": "1.0.0-conformance.1",
              "limits": {
                "max_size": 16777216,
                "max_nesting": 1024,
                "max_depth": 256,
                "max_path_segments": 256,
                "max_table_size": 2097152,
                "max_values": 1000000
              }
            },
            "contract": {
              "input": {
                "type": "object"
              },
              "output": {
                "keys": [
                  "discount"
                ]
              }
            },
            "cases": [
              {
                "path": "cases/good.json",
                "digest": "sha256:48dbc7a42e9834a0cc6762d5636be1f6310567a59fd39384ae9f47ed79da63c5"
              },
              {
                "path": "cases/other.json",
                "digest": "sha256:c9db45a2f7680432fbf9dc581827e45374c43748b657cedbf068a74693d86943"
              }
            ]
          }
        },
        "files": [
          {
            "path": "cases/good.json",
            "text": "{\"version\": 1, \"cases\": {\"items\": [{\"id\": \"vip\", \"input\": {\"customer\": {\"years\": 7}, \"order\": {\"total\": 2000}}, \"expect\": {\"selected\": [\"vip\"], \"output\": {\"discount\": {\"$decimal\": \"0.15\"}, \"label\": \"VIP\"}}}]}}"
          },
          {
            "path": "cases/other.json",
            "text": "{\"version\": 1, \"cases\": {\"items\": [{\"id\": \"new\", \"input\": {\"customer\": {\"years\": 1}}, \"expect\": {\"output\": null}}]}}"
          }
        ],
        "limits": {
          "max_explained": 0
        },
        "ruleset_digest": true
      },
      "expect": {
        "test_run": {
          "source": "decision_table",
          "hit_policy": "first",
          "logic": "boolean",
          "ruleset_digest": "sha256:ac5face379ffdf3fd8015e84ec1f5c71d371113016da6fcad6320d7894b29ee3",
          "engine": {
            "name": "cleanrules",
            "version": "0.0.0-this-engine",
            "limits": {
              "max_size": 16777216,
              "max_nesting": 1024,
              "max_depth": 256,
              "max_path_segments": 256,
              "max_table_size": 2097152,
              "max_values": 1000000
            }
          },
          "bundle": {
            "id": "acme/discounts",
            "revision": "1"
          },
          "files": [
            {
              "path": "cases/good.json",
              "digest": "sha256:48dbc7a42e9834a0cc6762d5636be1f6310567a59fd39384ae9f47ed79da63c5"
            },
            {
              "path": "cases/other.json",
              "digest": "sha256:c9db45a2f7680432fbf9dc581827e45374c43748b657cedbf068a74693d86943"
            }
          ],
          "limits": {
            "max_explained": 0
          },
          "summary": {
            "total": 2,
            "passed": 2,
            "failed": 0,
            "error": 0,
            "partial": false
          },
          "results": [
            {
              "path": "cases/good.json",
              "id": "vip",
              "status": "passed"
            },
            {
              "path": "cases/other.json",
              "id": "new",
              "status": "passed"
            }
          ]
        }
      }
    },

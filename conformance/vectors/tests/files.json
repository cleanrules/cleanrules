{
  "version": 1,
  "area": "tests",
  "vectors": [
    {
      "id": "tests/files/in-order-with-paths",
      "spec": [
        "tests.md#running-cases",
        "tests.md#identity",
        "tests.md#test-runs"
      ],
      "description": "case files run in the order given, each case with its file's path; two files may hold the same id, and an empty file gives no result",
      "given": {
        "kind": "test_run",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "first",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 0
                  }
                },
                "then": {
                  "v": {
                    "op": "const",
                    "value": 1
                  }
                }
              }
            ]
          }
        },
        "files": [
          {
            "path": "cases/a.json",
            "text": "{\"version\": 1, \"cases\": {\"items\": [{\"id\": \"one\", \"input\": {\"x\": 1}, \"expect\": {\"selected\": [\"a\"]}}, {\"id\": \"two\", \"input\": {\"x\": 0}}]}}"
          },
          {
            "path": "cases/empty.json",
            "text": "{\"version\": 1, \"cases\": {\"items\": []}}"
          },
          {
            "path": "cases/b.json",
            "text": "{\"version\": 1, \"cases\": {\"items\": [{\"id\": \"one\", \"input\": {\"x\": 0}, \"expect\": {\"selected\": []}}]}}"
          }
        ],
        "limits": {
          "max_explained": 0
        }
      },
      "expect": {
        "test_run": {
          "source": "ruleset",
          "hit_policy": "first",
          "logic": "boolean",
          "engine": {
            "name": "cleanrules",
            "version": "0.0.0-this-engine",
            "limits": {
              "max_size": 16777216,
              "max_nesting": 1024,
              "max_depth": 256,
              "max_path_segments": 256,
              "max_table_size": 2097152,
              "max_values": 1000000
            }
          },
          "files": [
            {
              "path": "cases/a.json",
              "digest": "sha256:c974ceb7874b505dd07bd9454bed5ebce90cc0d3cd59c89ead567dbc0ce9c149"
            },
            {
              "path": "cases/empty.json",
              "digest": "sha256:bc16a440106aa30627fa91e6d226ed0143eef8c2496e2d1954b0055dcae22ebc"
            },
            {
              "path": "cases/b.json",
              "digest": "sha256:f7f0081638701369c7b9974e72b766da83110ca37e9b873556ed3d6897bce4aa"
            }
          ],
          "limits": {
            "max_explained": 0
          },
          "summary": {
            "total": 3,
            "passed": 3,
            "failed": 0,
            "error": 0,
            "partial": false
          },
          "results": [
            {
              "path": "cases/a.json",
              "id": "one",
              "status": "passed"
            },
            {
              "path": "cases/a.json",
              "id": "two",
              "status": "passed"
            },
            {
              "path": "cases/b.json",
              "id": "one",
              "status": "passed"
            }
          ]
        }
      }
    },

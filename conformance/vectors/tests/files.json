    {
      "id": "tests/files/decision-table",
      "spec": [
        "tests.md#running-cases",
        "tests.md#matching",
        "tests.md#test-runs"
      ],
      "description": "a decision table is tested through the rule set it compiles to; the run names the table's own policy, here in the reason of a missing single output",
      "given": {
        "kind": "test_run",
        "document": {
          "version": 1,
          "decision_table": {
            "hit_policy": "collect",
            "logic": "boolean",
            "inputs": [
              "x"
            ],
            "outputs": [
              {
                "name": "v"
              }
            ],
            "rows": [
              {
                "name": "low",
                "inputs": [
                  "> 0"
                ],
                "outputs": [
                  "1"
                ]
              },
              {
                "inputs": [
                  "> 1"
                ],
                "outputs": [
                  "2"
                ]
              }
            ]
          }
        },
        "cases": {
          "version": 1,
          "cases": {
            "items": [
              {
                "id": "both",
                "input": {
                  "x": 2
                },
                "expect": {
                  "selected": [
                    "low",
                    "row_2"
                  ],
                  "outputs": [
                    {
                      "v": 1
                    },
                    {
                      "v": 2
                    }
                  ]
                }
              },
              {
                "id": "single",
                "input": {
                  "x": 1
                },
                "expect": {
                  "output": {
                    "v": 1
                  }
                }
              }
            ]
          }
        },
        "limits": {
          "max_explained": 0
        }
      },
      "expect": {
        "test_run": {
          "source": "decision_table",
          "hit_policy": "collect",
          "logic": "boolean",
          "engine": {
            "name": "cleanrules",
            "version": "0.0.0-this-engine",
            "limits": {
              "max_size": 16777216,
              "max_nesting": 1024,
              "max_depth": 256,
              "max_path_segments": 256,
              "max_table_size": 2097152,
              "max_values": 1000000
            }
          },
          "files": [
            {}
          ],
          "limits": {
            "max_explained": 0
          },
          "summary": {
            "total": 2,
            "passed": 1,
            "failed": 1,
            "error": 0,
            "partial": false
          },
          "results": [
            {
              "id": "both",
              "status": "passed"
            },
            {
              "id": "single",
              "status": "failed",
              "mismatches": [
                {
                  "key": "output",
                  "expected": {
                    "v": 1
                  },
                  "reason": "the decision has no single output (collect)"
                }
              ]
            }
          ]
        }
      }
    }

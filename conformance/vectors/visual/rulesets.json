    {
      "id": "visual/rulesets/collect-aggregate",
      "spec": [
        "visual.md#rule-sets",
        "visual.md#mermaid"
      ],
      "description": "The title names the aggregate; a field read by a condition and a payload has one solid edge",
      "given": {
        "kind": "draw",
        "format": "mermaid",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "collect",
            "aggregate": "sum",
            "rules": [
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "priority": 9,
                "then": {
                  "n": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  }
                }
              },
              {
                "name": "a",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "y"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 2
                  }
                },
                "then": {
                  "n": {
                    "op": "const",
                    "value": 2
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "diagram": "---\ntitle: \"HIT POLICY collect AGGREGATE sum\"\n---\nflowchart LR\n  accTitle: HIT POLICY collect AGGREGATE sum\n  n0([\"x\"])\n  n1([\"y\"])\n  n2(\"1. b<br>x #gt; 1\")\n  n3(\"2. a<br>y #gt; 2\")\n  n4[[\"n\"]]\n  n0 --> n2\n  n2 --> n4\n  n1 --> n3\n  n3 --> n4\n  classDef rule fill:#ffffff,stroke:#202124\n  classDef field fill:#ffffff,stroke:#5f6368\n  classDef output fill:#f3e8fd,stroke:#9334e6\n  class n2,n3 rule\n  class n0,n1 field\n  class n4 output\n"
      }
    },

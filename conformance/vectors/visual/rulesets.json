{
  "version": 1,
  "area": "visual",
  "vectors": [
    {
      "id": "visual/rulesets/priority-mermaid",
      "spec": [
        "visual.md#rule-sets",
        "visual.md#mermaid"
      ],
      "description": "Under priority, rules are ranked by priority, ties in rule order; payload-only reads are dashed",
      "given": {
        "kind": "draw",
        "format": "mermaid",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "priority",
            "rules": [
              {
                "name": "loyal",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "customer",
                      "years"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 2
                  }
                },
                "priority": 5,
                "do": "notify",
                "then": {
                  "discount": {
                    "op": "const",
                    "value": 5
                  }
                }
              },
              {
                "name": "vip",
                "when": {
                  "op": "and",
                  "operands": [
                    {
                      "op": "gt",
                      "left": {
                        "op": "field",
                        "path": [
                          "customer",
                          "years"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": 5
                      }
                    },
                    {
                      "op": "is_null",
                      "operand": {
                        "op": "field",
                        "path": [
                          "since"
                        ]
                      }
                    }
                  ]
                },
                "priority": 10,
                "description": "Best customers",
                "then": {
                  "discount": {
                    "op": "const",
                    "value": 15
                  },
                  "label": {
                    "op": "field",
                    "path": [
                      "customer",
                      "name"
                    ]
                  }
                }
              },
              {
                "name": "rest",
                "when": {
                  "op": "const",
                  "value": true
                },
                "then": {
                  "discount": {
                    "op": "const",
                    "value": 0
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "diagram": "---\ntitle: \"HIT POLICY priority\"\n---\nflowchart LR\n  accTitle: HIT POLICY priority\n  n0([\"customer.years\"])\n  n1([\"since\"])\n  n2([\"customer.name\"])\n  n3(\"1. vip<br>PRIORITY 10<br>customer.years #gt; 5 AND since IS NULL\")\n  n4(\"2. loyal<br>PRIORITY 5<br>customer.years #gt; 2<br>DO notify\")\n  n5(\"3. rest<br>PRIORITY 0<br>TRUE\")\n  n6[[\"discount\"]]\n  n7[[\"label\"]]\n  n0 --> n3\n  n1 --> n3\n  n2 -.-> n3\n  n3 --> n6\n  n3 --> n7\n  n0 --> n4\n  n4 --> n6\n  n5 --> n6\n  classDef rule fill:#ffffff,stroke:#202124\n  classDef field fill:#ffffff,stroke:#5f6368\n  classDef output fill:#f3e8fd,stroke:#9334e6\n  class n3,n4,n5 rule\n  class n0,n1,n2 field\n  class n6,n7 output\n"
      }
    },

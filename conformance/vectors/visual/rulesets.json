      "expect": {
        "diagram": "digraph cleanrules {\n  graph [rankdir=LR, fontname=\"Helvetica\", label=\"HIT POLICY priority\", labelloc=t];\n  node [fontname=\"Helvetica\", fontsize=11];\n  edge [color=\"#5f6368\"];\n  n0 [label=\"customer.years\", class=\"field\", shape=ellipse, style=\"filled\", fillcolor=\"#ffffff\", color=\"#5f6368\"];\n  n1 [label=\"since\", class=\"field\", shape=ellipse, style=\"filled\", fillcolor=\"#ffffff\", color=\"#5f6368\"];\n  n2 [label=\"customer.name\", class=\"field\", shape=ellipse, style=\"filled\", fillcolor=\"#ffffff\", color=\"#5f6368\"];\n  n3 [label=\"1. vip\\nPRIORITY 10\\ncustomer.years > 5 AND since IS NULL\", class=\"rule\", shape=box, style=\"rounded,filled\", fillcolor=\"#ffffff\", color=\"#202124\"];\n  n4 [label=\"2. loyal\\nPRIORITY 5\\ncustomer.years > 2\\nDO notify\", class=\"rule\", shape=box, style=\"rounded,filled\", fillcolor=\"#ffffff\", color=\"#202124\"];\n  n5 [label=\"3. rest\\nPRIORITY 0\\nTRUE\", class=\"rule\", shape=box, style=\"rounded,filled\", fillcolor=\"#ffffff\", color=\"#202124\"];\n  n6 [label=\"discount\", class=\"output\", shape=box, style=\"filled\", fillcolor=\"#f3e8fd\", color=\"#9334e6\"];\n  n7 [label=\"label\", class=\"output\", shape=box, style=\"filled\", fillcolor=\"#f3e8fd\", color=\"#9334e6\"];\n  n0 -> n3;\n  n1 -> n3;\n  n2 -> n3 [style=dashed];\n  n3 -> n6;\n  n3 -> n7;\n  n0 -> n4;\n  n4 -> n6;\n  n5 -> n6;\n}\n"
      }
    },
    {

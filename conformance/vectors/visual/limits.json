    {
      "id": "visual/limits/at-the-limit",
      "spec": [
        "visual.md#limits"
      ],
      "description": "An explanation of 12 nodes and 7 edges is drawn with a limit of 19",
      "given": {
        "kind": "draw",
        "format": "mermaid",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "priority",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "and",
                  "operands": [
                    {
                      "op": "gt",
                      "left": {
                        "op": "field",
                        "path": [
                          "x"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": 10
                      }
                    },
                    {
                      "op": "not",
                      "operand": {
                        "op": "le",
                        "left": {
                          "op": "field",
                          "path": [
                            "y"
                          ]
                        },
                        "right": {
                          "op": "const",
                          "value": 3
                        }
                      }
                    }
                  ]
                }
              },
              {
                "name": "b",
                "when": {
                  "op": "between",
                  "operand": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "low": {
                    "op": "const",
                    "value": 0
                  },
                  "high": {
                    "op": "const",
                    "value": 5
                  }
                }
              },
              {
                "name": "c",
                "when": {
                  "op": "and",
                  "operands": [
                    {
                      "op": "gt",
                      "left": {
                        "op": "field",
                        "path": [
                          "x"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": 1
                      }
                    },
                    {
                      "op": "not",
                      "operand": {
                        "op": "gt",
                        "left": {
                          "op": "field",
                          "path": [
                            "x"
                          ]
                        },
                        "right": {
                          "op": "const",
                          "value": 1
                        }
                      }
                    }
                  ]
                }
              },
              {
                "name": "d",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "priority": 1
              },
              {
                "name": "e",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 0
                  }
                },
                "priority": 5
              }
            ]
          }
        },
        "input": {
          "x": 8,
          "y": 2
        },
        "limits": {
          "max_diagram_size": 19
        }
      },
      "expect": {
        "diagram": "---\ntitle: \"HIT POLICY priority: selected e\"\n---\nflowchart TD\n  accTitle: HIT POLICY priority: selected e\n  n0(\"[ ] a (not fired)<br>x #gt; 10 AND NOT y #lt;= 3\")\n  n1([\"all of\"])\n  n2[\"x #gt; 10<br>false (x = 8)<br>short by 2\"]\n  n3[\"y #lt;= 3<br>true (y = 2), but the rule needs it false<br>needs y #gt; 3 (short by 1)\"]\n  n4(\"[ ] b (not fired)<br>x BETWEEN 0 AND 5\")\n  n5[\"x #lt;= 5<br>false (x = 8)<br>over by 3\"]\n  n6(\"[ ] c (not fired)<br>x #gt; 1 AND NOT x #gt; 1<br>cannot fire by changing these conditions alone; they conflict\")\n  n7[\"x #gt; 1<br>true (x = 8), but the rule needs it false<br>needs x #lt;= 1 (over by 7)\"]\n  n8(\"[x] d (fired, not selected)<br>x #gt; 1<br>fired, but e has a higher priority (5 #gt; 1)\")\n  n9[\"x #gt; 1<br>true (x = 8)\"]\n  n10(\"[x] e (selected)<br>x #gt; 0\")\n  n11[\"x #gt; 0<br>true (x = 8)\"]\n  n0 --> n1\n  n1 --> n2\n  n1 --> n3\n  n4 --> n5\n  n6 --> n7\n  n8 --> n9\n  n10 --> n11\n  classDef connective fill:#ffffff,stroke:#5f6368\n  classDef rule_selected fill:#e8f0fe,stroke:#1a73e8,stroke-width:2px\n  classDef rule_fired fill:#ffffff,stroke:#1a73e8\n  classDef rule_not_fired fill:#ffffff,stroke:#5f6368\n  classDef truth_true fill:#e6f4ea,stroke:#1e8e3e\n  classDef truth_false fill:#fce8e6,stroke:#d93025\n  class n1 connective\n  class n10 rule_selected\n  class n8 rule_fired\n  class n0,n4,n6 rule_not_fired\n  class n3,n7,n9,n11 truth_true\n  class n2,n5 truth_false\n"
      }
    },

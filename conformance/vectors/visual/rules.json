      "expect": {
        "diagram": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>cleanrules: rule</title>\n<style>\n.cleanrules{font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#202124}\n.cleanrules .title{font-weight:bold;margin:0 0 8px}\n.cleanrules ul.tree,.cleanrules ul.tree ul{list-style:none;margin:0;padding-left:24px}\n.cleanrules ul.tree{padding-left:0}\n.cleanrules ul.tree ul{border-left:1px solid #dadce0}\n.cleanrules li{margin:4px 0}\n.cleanrules .node{display:inline-block;border-radius:3px;padding:2px 6px}\n.cleanrules .description{white-space:pre-wrap;color:#5f6368;font-style:italic}\n.cleanrules .payload{font-style:italic}\n.cleanrules table{border-collapse:collapse}\n.cleanrules caption{font-weight:bold;text-align:left;margin-bottom:4px}\n.cleanrules th,.cleanrules td{border:1px solid #dadce0;padding:2px 6px;text-align:left;vertical-align:top}\n.cleanrules .connective{background:#ffffff;border:1px solid #5f6368;border-radius:12px}\n.cleanrules .leaf{background:#f8f9fa;border:1px solid #5f6368}\n.cleanrules .rule{background:#ffffff;border:1px solid #202124;border-radius:8px}\n.cleanrules .rule_selected{background:#e8f0fe;border:2px solid #1a73e8;border-radius:8px}\n.cleanrules .rule_fired{background:#ffffff;border:1px solid #1a73e8;border-radius:8px}\n.cleanrules .rule_not_fired{background:#ffffff;border:1px solid #5f6368;border-radius:8px}\n.cleanrules .rule_unknown{background:#f1f3f4;border:1px dashed #80868b;border-radius:8px}\n.cleanrules .truth_true{background:#e6f4ea;border:1px solid #1e8e3e}\n.cleanrules .truth_false{background:#fce8e6;border:1px solid #d93025}\n.cleanrules .truth_unknown{background:#f1f3f4;border:1px dashed #80868b}\n.cleanrules .truth_degree{background:#fef7e0;border:1px solid #f9ab00}\n.cleanrules .field{background:#ffffff;border:1px solid #5f6368;border-radius:12px}\n.cleanrules .output{background:#f3e8fd;border:1px solid #9334e6}\n</style>\n</head>\n<body>\n<div class=\"cleanrules cleanrules-rule\">\n<ul class=\"tree\">\n<li><div class=\"node rule\" style=\"background:#ffffff;border:1px solid #202124;border-radius:8px\"><div class=\"line\">RULE vip PRIORITY 10</div><div class=\"description\">Loyal customers\nwith &lt;large&gt; orders</div></div>\n<ul>\n<li><div class=\"node connective\" style=\"background:#ffffff;border:1px solid #5f6368;border-radius:12px\"><div class=\"line\">all</div></div>\n<ul>\n<li><div class=\"node leaf\" style=\"background:#f8f9fa;border:1px solid #5f6368\"><div class=\"line\">customer.years &gt; 5</div></div></li>\n<li><div class=\"node leaf\" style=\"background:#f8f9fa;border:1px solid #5f6368\"><div class=\"line\">order.total &gt; 1000</div></div></li>\n</ul>\n</li>\n<li><div class=\"node output\" style=\"background:#f3e8fd;border:1px solid #9334e6\"><div class=\"line\">THEN discount = 0.15</div></div></li>\n<li><div class=\"node output\" style=\"background:#f3e8fd;border:1px solid #9334e6\"><div class=\"line\">THEN label = &quot;gold&quot;</div></div></li>\n<li><div class=\"node output\" style=\"background:#f3e8fd;border:1px solid #9334e6\"><div class=\"line\">DO notify</div></div></li>\n</ul>\n</li>\n</ul>\n</div>\n</body>\n</html>\n"
      }
    },
    {
      "id": "visual/rules/plain",
      "spec": [
        "visual.md#rules",
        "visual.md#dot"
      ],
      "description": "A rule of priority 0 with no outputs: only its header and condition",
      "given": {
        "kind": "draw",
        "format": "dot",
        "document": {
          "version": 1,
          "rule": {
            "name": "adult",
            "when": {
              "op": "ge",
              "left": {
                "op": "field",
                "path": [
                  "age"
                ]
              },
              "right": {
                "op": "const",
                "value": 18
              }
            }
          }
        }
      },
      "expect": {
        "diagram": "digraph cleanrules {\n  graph [rankdir=TB, fontname=\"Helvetica\"];\n  node [fontname=\"Helvetica\", fontsize=11];\n  edge [color=\"#5f6368\"];\n  n0 [label=\"RULE adult\", class=\"rule\", shape=box, style=\"rounded,filled\", fillcolor=\"#ffffff\", color=\"#202124\"];\n  n1 [label=\"age >= 18\", class=\"leaf\", shape=box, style=\"filled\", fillcolor=\"#f8f9fa\", color=\"#5f6368\"];\n  n0 -> n1;\n}\n"
      }
    },

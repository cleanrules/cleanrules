        "diagram": "digraph cleanrules {\n  graph [rankdir=TB, fontname=\"Helvetica\"];\n  node [fontname=\"Helvetica\", fontsize=11];\n  edge [color=\"#5f6368\"];\n  n0 [label=\"RULE vip PRIORITY 10\", class=\"rule\", shape=box, style=\"rounded,filled\", fillcolor=\"#ffffff\", color=\"#202124\"];\n  n1 [label=\"all\", class=\"connective\", shape=ellipse, style=\"filled\", fillcolor=\"#ffffff\", color=\"#5f6368\"];\n  n2 [label=\"customer.years > 5\", class=\"leaf\", shape=box, style=\"filled\", fillcolor=\"#f8f9fa\", color=\"#5f6368\"];\n  n3 [label=\"order.total > 1000\", class=\"leaf\", shape=box, style=\"filled\", fillcolor=\"#f8f9fa\", color=\"#5f6368\"];\n  n4 [label=\"THEN discount = 0.15\", class=\"output\", shape=box, style=\"filled\", fillcolor=\"#f3e8fd\", color=\"#9334e6\"];\n  n5 [label=\"THEN label = \\\"gold\\\"\", class=\"output\", shape=box, style=\"filled\", fillcolor=\"#f3e8fd\", color=\"#9334e6\"];\n  n6 [label=\"DO notify\", class=\"output\", shape=box, style=\"filled\", fillcolor=\"#f3e8fd\", color=\"#9334e6\"];\n  n0 -> n1;\n  n1 -> n2;\n  n1 -> n3;\n  n0 -> n4 [style=dashed];\n  n0 -> n5 [style=dashed];\n  n0 -> n6 [style=dashed];\n}\n"

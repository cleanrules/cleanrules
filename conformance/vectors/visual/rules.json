{
  "version": 1,
  "area": "visual",
  "vectors": [
    {
      "id": "visual/rules/outputs-and-action-mermaid",
      "spec": [
        "visual.md#rules",
        "visual.md#mermaid"
      ],
      "description": "A rule in mermaid: its header, condition, payload entries and named action",
      "given": {
        "kind": "draw",
        "format": "mermaid",
        "document": {
          "version": 1,
          "rule": {
            "name": "vip",
            "when": {
              "op": "and",
              "operands": [
                {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "customer",
                      "years"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 5
                  }
                },
                {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "order",
                      "total"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1000
                  }
                }
              ]
            },
            "priority": 10,
            "description": "Loyal customers\nwith <large> orders",
            "do": "notify",
            "then": {
              "discount": {
                "op": "const",
                "value": {
                  "$decimal": "0.15"
                }
              },
              "label": {
                "op": "const",
                "value": "gold"
              }
            }
          }
        }
      },
      "expect": {
        "diagram": "flowchart TD\n  n0(\"RULE vip PRIORITY 10\")\n  n1([\"all\"])\n  n2[\"customer.years #gt; 5\"]\n  n3[\"order.total #gt; 1000\"]\n  n4[[\"THEN discount = 0.15\"]]\n  n5[[\"THEN label = #quot;gold#quot;\"]]\n  n6[[\"DO notify\"]]\n  n0 --> n1\n  n1 --> n2\n  n1 --> n3\n  n0 -.-> n4\n  n0 -.-> n5\n  n0 -.-> n6\n  classDef connective fill:#ffffff,stroke:#5f6368\n  classDef leaf fill:#f8f9fa,stroke:#5f6368\n  classDef rule fill:#ffffff,stroke:#202124\n  classDef output fill:#f3e8fd,stroke:#9334e6\n  class n1 connective\n  class n2,n3 leaf\n  class n0 rule\n  class n4,n5,n6 output\n"
      }
    },

    {
      "id": "rules/limits/lists-at-the-limit",
      "spec": [
        "data-model.md#limits",
        "json-format.md#errors-and-limits"
      ],
      "description": "a list converted where a path ends counts itself and each element, nested lists included: 5 values within a limit of 5",
      "given": {
        "kind": "evaluate",
        "ruleset": {
          "hit_policy": "first",
          "logic": "boolean",
          "rules": [
            {
              "name": "r",
              "when": {
                "op": "is_null",
                "operand": {
                  "op": "field",
                  "path": [
                    "a"
                  ]
                }
              }
            }
          ]
        },
        "input": {
          "a": [
            1,
            [
              2,
              3
            ]
          ]
        },
        "limits": {
          "max_values": 5
        }
      },
      "expect": {
        "decision": {
          "hit_policy": "first",
          "logic": "boolean",
          "results": [
            {
              "rule": "r",
              "fired": false,
              "when": {
                "op": "is_null",
                "truth": false,
                "children": [
                  {
                    "op": "field",
                    "path": [
                      "a"
                    ],
                    "value": [
                      1,
                      [
                        2,
                        3
                      ]
                    ]
                  }
                ]
              }
            }
          ],
          "selected": []
        }
      }
    },

          "hit_policy": "first",
          "logic": "boolean",
          "results": [
            {
              "rule": "r",
              "fired": false,
              "when": {
                "op": "is_null",
                "truth": false,
                "children": [
                  {
                    "op": "field",
                    "path": [
                      "a"
                    ],
                    "value": {
                      "b": [
                        1,
                        2
                      ]
                    }
                  }
                ]
              }
            },
            {
              "rule": "s",
              "fired": true,
              "when": {
                "op": "gt",
                "truth": true,
                "children": [
                  {
                    "op": "field",
                    "path": [
                      "a",
                      "b",
                      0
                    ],
                    "value": 1
                  },
                  {
                    "op": "const",
                    "value": 0
                  }
                ]
              },
              "then": {}
            }
          ],
          "selected": [
            "s"
          ]
        }
      }
    },

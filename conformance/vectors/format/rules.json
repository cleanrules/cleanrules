                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "a"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "do": "billing.notify"
              },
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "a"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "do": "send email ✉"
              },
              {
                "name": "c",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "a"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "rule_order",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "a"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "do": "billing.notify"
              },
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "a"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "do": "send email ✉"
              },
              {
                "name": "c",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "a"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                }
              }
            ]
          }
        }
      }

    {
      "id": "format/rules/key-order",
      "spec": [
        "json-format.md#rules",
        "errors.md#which-error-comes-first"
      ],
      "description": "rule keys are written in table order",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "rule": {
            "tags": [
              "t"
            ],
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "name": "r"
          }
        }
      },
      "expect": {
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "tags": [
              "t"
            ]
          }
        }
      }
    },
    {
      "id": "format/rules/payload-order",
      "spec": [
        "json-format.md#rules",
        "errors.md#which-error-comes-first"
      ],
      "description": "payload members keep their order",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "then": {
              "b": {
                "op": "const",
                "value": 1
              },
              "a": {
                "op": "const",
                "value": 2
              },
              "10": {
                "op": "const",
                "value": 3
              },
              "2": {
                "op": "const",
                "value": 4
              }
            }
          }
        }
      },
      "expect": {
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "then": {
              "b": {
                "op": "const",
                "value": 1
              },
              "a": {
                "op": "const",
                "value": 2
              },
              "10": {
                "op": "const",
                "value": 3
              },
              "2": {
                "op": "const",
                "value": 4
              }
            }
          }
        }
      }
    },

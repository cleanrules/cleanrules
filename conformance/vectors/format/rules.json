              "right": {
                "op": "const",
                "value": 1
              }
            },
            "tags": [
              "b",
              "a",
              "b"
            ]
          }
        }
      },
      "expect": {
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "tags": [
              "a",
              "b"
            ]
          }
        }
      }
    },
    {

        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "metadata": {
              "owner": "sales"

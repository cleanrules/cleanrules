{
  "version": 1,
  "area": "format",
  "vectors": [
    {
      "id": "format/rules/defaults-omitted",
      "spec": [
        "json-format.md#rules"
      ],
      "description": "optional keys at their default are omitted",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "then": {},
            "priority": 0,
            "tags": [],
            "metadata": {}
          }
        }
      },
      "expect": {
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            }
          }
        }
      }
    },
    {
      "id": "format/rules/tags-are-a-set",
      "spec": [
        "json-format.md#rules"
      ],
      "description": "tags are deduplicated and sorted",
      "given": {
        "kind": "read",
        "document": {

    {
      "id": "format/rules/named-action-any-text",
      "spec": [
        "json-format.md#rules",
        "rules.md#actions"
      ],
      "description": "An action name is any non-empty string, read literally",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "rule_order",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",

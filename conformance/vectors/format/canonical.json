{
  "version": 1,
  "area": "format",
  "vectors": [
    {
      "id": "format/canonical/ruleset-example",
      "spec": [
        "json-format.md#canonical-bytes",
        "json-format.md#digests"
      ],
      "description": "the rule set of the spec's example: members sorted by code point at every level",
      "given": {
        "kind": "canonical",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "first",
            "logic": "boolean",
            "rules": [
              {
                "name": "vip",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "years"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 5
                  }
                },
                "then": {
                  "discount": {
                    "op": "const",
                    "value": {
                      "$decimal": "0.15"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "canonical": "{\"ruleset\":{\"hit_policy\":\"first\",\"logic\":\"boolean\",\"rules\":[{\"name\":\"vip\",\"then\":{\"discount\":{\"op\":\"const\",\"value\":{\"$decimal\":\"0.15\"}}},\"when\":{\"left\":{\"op\":\"field\",\"path\":[\"years\"]},\"op\":\"gt\",\"right\":{\"op\":\"const\",\"value\":5}}}]},\"version\":1}",
        "digest": "sha256:5a0e590cb8f3bd57392ede84c0d0c4596cf9374fefcbcc6b28ed61421878f312",
        "ruleset_digest": "sha256:5a0e590cb8f3bd57392ede84c0d0c4596cf9374fefcbcc6b28ed61421878f312"
      }
    },
    {
      "id": "format/canonical/layout-and-member-order",
      "spec": [
        "json-format.md#canonical-bytes",
        "json-format.md#digests"
      ],
      "description": "the same rule set with other whitespace, member order, escapes and number layout: the same bytes and digest",
      "given": {
        "kind": "canonical",
        "text": "{ \"ruleset\" : {\"rules\":[{\"then\":{\"discount\":{\"value\":{\"$decimal\":\"1.5e-1\"},\"op\":\"const\"}},\n\"when\":{\"right\":{\"value\":{\"$int\":\"005\"},\"op\":\"const\"},\"op\":\"gt\",\"left\":{\"path\":[\"y\\u0065ars\"],\"op\":\"field\"}},\"name\":\"\\u0076ip\"}],\r\n\"logic\":\"boolean\",\"hit_policy\":\"first\"},\"$schema\":\"x\",\"version\":1}"
      },
      "expect": {
        "canonical": "{\"ruleset\":{\"hit_policy\":\"first\",\"logic\":\"boolean\",\"rules\":[{\"name\":\"vip\",\"then\":{\"discount\":{\"op\":\"const\",\"value\":{\"$decimal\":\"0.15\"}}},\"when\":{\"left\":{\"op\":\"field\",\"path\":[\"years\"]},\"op\":\"gt\",\"right\":{\"op\":\"const\",\"value\":5}}}]},\"version\":1}",
        "digest": "sha256:5a0e590cb8f3bd57392ede84c0d0c4596cf9374fefcbcc6b28ed61421878f312",
        "ruleset_digest": "sha256:5a0e590cb8f3bd57392ede84c0d0c4596cf9374fefcbcc6b28ed61421878f312"
      }
    },
    {

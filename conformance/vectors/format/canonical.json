    {
      "id": "format/canonical/decision-table",
      "spec": [
        "json-format.md#canonical-bytes",
        "json-format.md#rule-set-digests"
      ],
      "description": "a decision table: the digest of its own document, and the rule set digest of the rule set it compiles to",
      "given": {
        "kind": "canonical",
        "document": {
          "version": 1,
          "decision_table": {
            "hit_policy": "first",
            "logic": "boolean",
            "inputs": [
              "customer.years",
              "order.total"
            ],
            "outputs": [
              {
                "name": "discount"
              },
              {
                "name": "label"
              }
            ],
            "rows": [
              {
                "name": "vip",
                "inputs": [
                  "> 5",
                  "> 1000"
                ],
                "outputs": [
                  "0.15",
                  "'VIP'"
                ]
              },
              {
                "name": "loyal",
                "inputs": [
                  "> 2",
                  "-"
                ],
                "outputs": [
                  "0.05",
                  "'loyal'"
                ]
              }
            ]
          }
        }
      },
      "expect": {
        "canonical": "{\"decision_table\":{\"hit_policy\":\"first\",\"inputs\":[\"customer.years\",\"order.total\"],\"logic\":\"boolean\",\"outputs\":[{\"name\":\"discount\"},{\"name\":\"label\"}],\"rows\":[{\"inputs\":[\"> 5\",\"> 1000\"],\"name\":\"vip\",\"outputs\":[\"0.15\",\"'VIP'\"]},{\"inputs\":[\"> 2\",\"-\"],\"name\":\"loyal\",\"outputs\":[\"0.05\",\"'loyal'\"]}]},\"version\":1}",
        "digest": "sha256:25b8eed192147951cd20449c7886c2b8e3d7ff096c74c978c3d0b87ce00cb8ba",
        "ruleset_digest": "sha256:ac5face379ffdf3fd8015e84ec1f5c71d371113016da6fcad6320d7894b29ee3"
      }
    },

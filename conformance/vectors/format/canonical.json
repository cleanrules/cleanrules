    {
      "id": "format/canonical/in-normalized",
      "spec": [
        "json-format.md#canonical-bytes"
      ],
      "description": "in values are normalized before the bytes are written: duplicates and order of the text do not change the digest",
      "given": {
        "kind": "canonical",
        "document": {
          "version": 1,

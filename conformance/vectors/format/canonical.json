    {
      "id": "format/canonical/rule",
      "spec": [
        "json-format.md#canonical-bytes",
        "json-format.md#rule-set-digests"
      ],
      "description": "a rule document with every optional key: its digest, and the rule set digest of a rule set of that rule with the default settings",
      "given": {
        "kind": "canonical",
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "gt",
              "left": {
                "op": "field",
                "path": [
                  "x"
                ]
              },
              "right": {
                "op": "const",
                "value": 1
              }
            },
            "then": {
              "y": {
                "op": "const",
                "value": "z"
              }
            },
            "priority": 10,
            "tags": [
              "b",
              "a"
            ],
            "description": "d",
            "metadata": {
              "owner": "ops"
            },
            "do": "notify"
          }
        }
      },
      "expect": {
        "canonical": "{\"rule\":{\"description\":\"d\",\"do\":\"notify\",\"metadata\":{\"owner\":\"ops\"},\"name\":\"r\",\"priority\":10,\"tags\":[\"a\",\"b\"],\"then\":{\"y\":{\"op\":\"const\",\"value\":\"z\"}},\"when\":{\"left\":{\"op\":\"field\",\"path\":[\"x\"]},\"op\":\"gt\",\"right\":{\"op\":\"const\",\"value\":1}}},\"version\":1}",
        "digest": "sha256:69a2c6eaf591901733881d17516502f9cc79b90a1fa1a12851097eb72e48af20",
        "ruleset_digest": "sha256:b36f63a0f7be55bde40e55676b6fc4435c4d0c2d123af2956f51ce49b557122a"
      }
    },

    {
      "id": "format/canonical/floats-plain",
      "spec": [
        "json-format.md#canonical-bytes"
      ],
      "description": "floats with an exponent from -4 to 15 in plain notation, with a point",
      "given": {
        "kind": "canonical",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "first",
            "logic": "boolean",
            "rules": [
              {
                "name": "r",
                "when": {
                  "op": "const",
                  "value": true
                },
                "then": {
                  "a": {
                    "op": "const",
                    "value": {
                      "$float": 1
                    }
                  },
                  "b": {
                    "op": "const",
                    "value": 1e2
                  },
                  "c": {
                    "op": "const",
                    "value": 0.1
                  },
                  "d": {
                    "op": "const",
                    "value": 0.0001
                  },
                  "e": {
                    "op": "const",
                    "value": -7.5
                  },
                  "f": {
                    "op": "const",
                    "value": 1e15
                  },
                  "g": {
                    "op": "const",
                    "value": 9999999999999998.0
                  },
                  "h": {
                    "op": "const",
                    "value": 123.456
                  },
                  "i": {
                    "op": "const",
                    "value": 0.0
                  },
                  "j": {
                    "op": "const",
                    "value": -0.0
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "canonical": "{\"ruleset\":{\"hit_policy\":\"first\",\"logic\":\"boolean\",\"rules\":[{\"name\":\"r\",\"then\":{\"a\":{\"op\":\"const\",\"value\":1.0},\"b\":{\"op\":\"const\",\"value\":100.0},\"c\":{\"op\":\"const\",\"value\":0.1},\"d\":{\"op\":\"const\",\"value\":0.0001},\"e\":{\"op\":\"const\",\"value\":-7.5},\"f\":{\"op\":\"const\",\"value\":1000000000000000.0},\"g\":{\"op\":\"const\",\"value\":9999999999999998.0},\"h\":{\"op\":\"const\",\"value\":123.456},\"i\":{\"op\":\"const\",\"value\":0.0},\"j\":{\"op\":\"const\",\"value\":-0.0}},\"when\":{\"op\":\"const\",\"value\":true}}]},\"version\":1}",

    {
      "id": "format/conditions/in-sorted",
      "spec": [
        "json-format.md#reading",
        "json-format.md#writing"
      ],
      "description": "in values are sorted and deduplicated",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "condition": {
            "op": "in",
            "operand": {
              "op": "field",
              "path": [
                "a"
              ]
            },
            "values": [
              "b",
              "a",
              "b"
            ]
          }
        }
      },
      "expect": {
        "document": {
          "version": 1,
          "condition": {
            "op": "in",
            "operand": {
              "op": "field",
              "path": [
                "a"
              ]
            },
            "values": [
              "a",
              "b"
            ]
          }
        }
      }
    },
    {
      "id": "format/conditions/in-number-types",
      "spec": [
        "json-format.md#writing",
        "ast.md#structural-identity"
      ],
      "description": "equal numbers of different types are kept, decimal before float before int",
      "given": {
        "kind": "read",
        "text": "{\"version\":1,\"condition\":{\"op\":\"in\",\"operand\":{\"op\":\"field\",\"path\":[\"a\"]},\"values\":[2,1,1.0,{\"$decimal\":\"1\"}]}}"
      },
      "expect": {
        "document": {
          "version": 1,
          "condition": {
            "op": "in",
            "operand": {
              "op": "field",
              "path": [
                "a"
              ]
            },
            "values": [
              {
                "$decimal": "1"
              },
              1.0,
              1,
              2
            ]
          }
        }
      }
    },
    {
      "id": "format/conditions/in-same-node-first-kept",
      "spec": [
        "json-format.md#writing",
        "errors.md#which-error-comes-first",
        "ast.md#structural-identity"
      ],
      "description": "of two values that are the same node, the first is kept",
      "given": {
        "kind": "read",
        "text": "{\"version\":1,\"condition\":{\"op\":\"in\",\"operand\":{\"op\":\"field\",\"path\":[\"a\"]},\"values\":[-0.0,0.0,{\"$decimal\":\"1.00\"},{\"$decimal\":\"1.0\"}]}}"
      },
      "expect": {
        "document": {
          "version": 1,
          "condition": {
            "op": "in",
            "operand": {
              "op": "field",
              "path": [
                "a"
              ]
            },
            "values": [
              -0.0,
              {
                "$decimal": "1.00"
              }
            ]
          }
        }
      }
    },

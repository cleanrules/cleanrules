{
  "version": 1,
  "area": "format",
  "vectors": [
    {
      "id": "format/conditions/and-flattened",
      "spec": [
        "json-format.md#reading",
        "json-format.md#writing"
      ],
      "description": "a nested and is flattened",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "condition": {
            "op": "and",
            "operands": [
              {
                "op": "and",
                "operands": [
                  {
                    "op": "field",
                    "path": [
                      "a"
                    ]
                  },
                  {
                    "op": "field",
                    "path": [
                      "b"
                    ]
                  }
                ]
              },
              {
                "op": "field",
                "path": [
                  "c"
                ]
              }
            ]
          }
        }
      },
      "expect": {
        "document": {
          "version": 1,
          "condition": {
            "op": "and",
            "operands": [
              {
                "op": "field",
                "path": [
                  "a"
                ]
              },
              {
                "op": "field",
                "path": [
                  "b"
                ]
              },
              {
                "op": "field",
                "path": [
                  "c"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "format/conditions/and-one-operand-as-written",

{
  "version": 1,
  "area": "format",
  "vectors": [
    {
      "id": "format/yaml/block-ruleset",
      "spec": [
        "json-format.md#yaml"
      ],
      "description": "A rule set in block style reads as the same JSON document",
      "given": {
        "kind": "read",
        "yaml": "version: 1\nruleset:\n  hit_policy: priority\n  rules:\n    - name: vip\n      when:\n        op: gt\n        left: {op: field, path: [customer, years]}\n        right: {op: const, value: 5}\n      then:\n        discount: {op: const, value: {$decimal: \"0.15\"}}\n      priority: 10\n"
      },
      "expect": {
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "priority",
            "logic": "boolean",
            "rules": [
              {
                "name": "vip",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "customer",
                      "years"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 5
                  }
                },
                "then": {
                  "discount": {
                    "op": "const",
                    "value": {
                      "$decimal": "0.15"
                    }
                  }
                },
                "priority": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": "format/yaml/unquoted-date-is-a-string",
      "spec": [
        "json-format.md#yaml"
      ],
      "description": "An unquoted 2026-10-31 is a string, never a date",
      "given": {
        "kind": "read",
        "yaml": "version: 1\ncondition:\n  op: eq\n  left: {op: field, path: [x]}\n  right:\n    op: const\n    value: 2026-10-31\n"
      },
      "expect": {
        "document": {
          "version": 1,
          "condition": {
            "op": "eq",
            "left": {
              "op": "field",
              "path": [
                "x"
              ]
            },
            "right": {
              "op": "const",
              "value": "2026-10-31"
            }
          }
        }
      }
    },

      "expect": {
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "field",
              "path": [
                "ok"
              ]
            },
            "metadata": {
              "1": "one",
              "true": "yes"
            }
          }
        }
      }
    },

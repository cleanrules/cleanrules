      "given": {
        "kind": "read",
        "yaml": "version: 1\nrule:\n  name: r\n  when: {op: field, path: [ok]}\n  metadata:\n    ? \n    : 1\n"
      },
      "expect": {
        "document": {
          "version": 1,
          "rule": {
            "name": "r",
            "when": {
              "op": "field",
              "path": [
                "ok"
              ]

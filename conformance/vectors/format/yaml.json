      "spec": [
        "json-format.md#yaml"
      ],
      "description": "A byte order mark at the start is allowed, as YAML allows it",
      "given": {
        "kind": "read",
        "yaml": "﻿version: 1\ncondition: {op: const, value: true}\n"
      },
      "expect": {
        "document": {
          "version": 1,
          "condition": {
            "op": "const",
            "value": true

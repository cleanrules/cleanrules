    },
    {
      "id": "format/rulesets/graded-logic-after-rule-names",
      "spec": [
        "json-format.md#rule-sets",
        "ast.md#logics"
      ],
      "description": "the logic is checked after the rule names",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "ruleset": {
            "logic": "min",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "const",
                  "value": true
                }
              },
              {
                "name": "a",
                "when": {
                  "op": "const",
                  "value": true
                }
              }
            ]
          }
        }
      },
      "expect": {
        "error": {
          "code": "rule_definition_error",
          "pointer": "/ruleset/rules/1/name"
        }
      }
    },

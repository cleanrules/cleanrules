          "version": 1,
          "ruleset": {
            "logic": "magic",
            "rules": []
          }
        }
      },
      "expect": {
        "error": {
          "code": "registry_error",
          "name": "magic",
          "pointer": "/ruleset/logic"
        }
      }
    },
    {
      "id": "format/rulesets/graded-logic-unsupported",
      "spec": [
        "json-format.md#rule-sets",
        "ast.md#logics"
      ],
      "description": "a rule set under a graded logic is unsupported until rules fire to degrees",
      "given": {
        "kind": "read",
        "document": {
          "version": 1,
          "ruleset": {
            "logic": "lukasiewicz",
            "rules": []
          }
        }
      },
      "expect": {
        "error": {
          "code": "unsupported"
        }
      }
    },
    {
      "id": "format/rulesets/graded-alias-unsupported",
      "spec": [
        "json-format.md#rule-sets",

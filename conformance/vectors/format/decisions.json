        "ruleset": {
          "hit_policy": "first",
          "logic": "boolean",
          "rules": [
            {
              "name": "a",
              "when": {
                "op": "gt",
                "left": {
                  "op": "field",
                  "path": [
                    "x"
                  ]
                },
                "right": {
                  "op": "const",

                    {
                      "op": "field",
                      "path": [
                        "x"
                      ],
                      "value": 2
                    },
                    {
                      "op": "const",
                      "value": 1
                    }
                  ]
                },
                "then": {
                  "y": {
                    "op": "const",
                    "value": 1

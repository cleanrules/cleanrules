    {
      "id": "agents/errors/hit-policy",
      "spec": [
        "agents.md#errors"
      ],
      "description": "a hit policy that cannot decide is a tool error with the rules, and no pointer",
      "given": {
        "kind": "tool",
        "rulesets": {
          "unique": {
            "hit_policy": "unique",
            "logic": "boolean",
            "rules": [
              {
                "name": "p",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 0
                  }
                },
                "then": {
                  "y": {
                    "op": "const",
                    "value": 1
                  }
                }
              },
              {
                "name": "q",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 1
                  }
                },
                "then": {
                  "y": {
                    "op": "const",
                    "value": 2
                  }
                }
              }
            ]
          }
        },
        "tool": "evaluate",
        "arguments": {
          "ruleset": "unique",
          "input": {
            "x": 5
          }
        }
      },
      "expect": {
        "error": {
          "code": "hit_policy_error",
          "rules": [
            "p",
            "q"
          ]
        }
      }
    }

{
  "version": 1,
  "area": "audit",
  "vectors": [
    {
      "id": "audit/shadowed/first",
      "spec": [
        "audit.md#shadowed-rules",
        "audit.md#overlaps"
      ],
      "description": "under first, a rule that fires only when an earlier one fires is shadowed; a last rule TRUE is not",
      "given": {
        "kind": "audit",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "first",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 3
                  }
                }
              },
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 5
                  }
                }
              },
              {
                "name": "c",
                "when": {
                  "op": "const",
                  "value": true
                }
              }
            ]
          }
        }
      },
      "expect": {
        "audit": {
          "source": "ruleset",
          "hit_policy": "first",
          "logic": "boolean",
          "limits": {
            "max_terms": 256,
            "max_steps": 1000000
          },
          "rules": [
            {
              "name": "a"
            },
            {
              "name": "b"
            },
            {
              "name": "c"
            }
          ],
          "checks": [
            {
              "check": "types",
              "status": "complete"
            },
            {
              "check": "fields",
              "status": "not_applicable"
            },
            {
              "check": "unsatisfiable",
              "status": "complete"
            },
            {
              "check": "shadowed",
              "status": "complete"
            },
            {
              "check": "overlap",
              "status": "complete"
            },
            {
              "check": "gap",
              "status": "complete"
            }
          ],
          "not_modelled": [],
          "undecided": [],
          "diagnostics": [
            {
              "code": "shadowed",
              "severity": "warning",
              "rules": [
                "b",
                "a"
              ]
            },
            {
              "code": "overlap",
              "severity": "info",
              "rules": [
                "a",
                "b"
              ]
            },
            {
              "code": "overlap",
              "severity": "info",
              "rules": [
                "a",
                "c"
              ]
            },
            {
              "code": "overlap",
              "severity": "info",
              "rules": [
                "b",
                "c"
              ]
            }
          ]
        }
      }
    },

              "name": "tie"
            }
          ],
          "checks": [
            {
              "check": "types",
              "status": "complete"
            },
            {
              "check": "fields",
              "status": "not_applicable"
            },
            {
              "check": "unsatisfiable",
              "status": "complete"
            },
            {
              "check": "shadowed",
              "status": "complete"
            },
            {
              "check": "overlap",
              "status": "complete"
            },
            {
              "check": "gap",
              "status": "complete"
            }
          ],
          "not_modelled": [],
          "undecided": [],
          "diagnostics": [
            {
              "code": "shadowed",
              "severity": "warning",
              "rules": [
                "low",
                "high",
                "tie"
              ]
            },
            {
              "code": "shadowed",
              "severity": "warning",
              "rules": [
                "tie",
                "high"
              ]
            },
            {
              "code": "overlap",
              "severity": "info",
              "rules": [
                "low",
                "high"
              ]
            },
            {
              "code": "overlap",
              "severity": "info",
              "rules": [
                "low",
                "tie"
              ]
            },
            {
              "code": "overlap",
              "severity": "info",
              "rules": [
                "high",
                "tie"
              ]
            },
            {
              "code": "gap",
              "severity": "warning",
              "rules": []
            }
          ]
        }
      }
    },

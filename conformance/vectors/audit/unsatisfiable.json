{
  "version": 1,
  "area": "audit",
  "vectors": [
    {
      "id": "audit/unsatisfiable/empty-ranges",
      "spec": [
        "audit.md#unsatisfiable-conditions",
        "audit.md#values-of-a-subject",
        "audit.md#combining-tests",
        "audit.md#gaps"
      ],
      "description": "contradictory comparisons, a between with crossed bounds, a value in and not in a list, no date after 9999-12-31 and none between two consecutive days: these rules never fire",
      "given": {
        "kind": "audit",
        "document": {

                      "right": {
                        "op": "const",
                        "value": {
                          "$date": "2026-01-01"
                        }
                      }
                    },
                    {
                      "op": "lt",
                      "left": {
                        "op": "field",
                        "path": [
                          "d"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": {
                          "$date": "2026-01-02"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "name": "f",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"

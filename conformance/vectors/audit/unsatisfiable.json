                  "operand": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "low": {
                    "op": "const",
                    "value": 10
                  },
                  "high": {
                    "op": "const",
                    "value": 1
                  },
                  "closed": "both"
                }
              },
              {
                "name": "c",

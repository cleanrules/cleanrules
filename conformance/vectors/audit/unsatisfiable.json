                  "op": "and",
                  "operands": [
                    {
                      "op": "in",
                      "operand": {
                        "op": "field",
                        "path": [
                          "x"
                        ]
                      },
                      "values": [
                        1,
                        2
                      ]
                    },
                    {
                      "op": "not",
                      "operand": {
                        "op": "in",
                        "operand": {
                          "op": "field",
                          "path": [
                            "x"
                          ]
                        },
                        "values": [
                          1,
                          2
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "name": "d",

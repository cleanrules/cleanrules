                "name": "a",
                "when": {
                  "op": "and",
                  "operands": [
                    {
                      "op": "gt",
                      "left": {
                        "op": "field",
                        "path": [
                          "x"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": 5
                      }
                    },
                    {
                      "op": "lt",
                      "left": {
                        "op": "field",
                        "path": [
                          "x"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": 3

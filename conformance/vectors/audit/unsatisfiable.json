    {
      "id": "audit/unsatisfiable/two-groups-at-once",
      "spec": [
        "audit.md#unsatisfiable-conditions",
        "audit.md#types",
        "audit.md#json"
      ],
      "description": "a value cannot be a string and a number at once; the report gives the aggregate and strictness, and in strict mode every supported input raises type_mismatch, so no witness shows a gap",
      "given": {
        "kind": "audit",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "collect",
            "aggregate": "sum",
            "logic": "boolean",
            "strict": true,
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "and",
                  "operands": [
                    {
                      "op": "eq",
                      "left": {
                        "op": "field",
                        "path": [
                          "x"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": "a"
                      }
                    },
                    {
                      "op": "gt",
                      "left": {
                        "op": "field",
                        "path": [
                          "x"
                        ]
                      },
                      "right": {
                        "op": "const",
                        "value": 5
                      }
                    }
                  ]
                },
                "then": {
                  "n": {
                    "op": "const",
                    "value": 1
                  }
                }
              }
            ]
          }
        }

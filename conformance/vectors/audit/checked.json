{
  "version": 1,
  "area": "audit",
  "vectors": [
    {
      "id": "audit/checked/not-modelled",
      "spec": [
        "audit.md#what-was-checked",
        "audit.md#tests"
      ],
      "description": "matches and a comparison of two fields are not modelled: they are listed, and what they leave undecided is said, with the reason not_modelled",
      "given": {
        "kind": "audit",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "unique",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "matches",
                  "operand": {
                    "op": "field",
                    "path": [
                      "name"
                    ]
                  },
                  "pattern": "^a"
                }
              },
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "x"
                    ]
                  },
                  "right": {
                    "op": "field",
                    "path": [
                      "y"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "audit": {
          "source": "ruleset",
          "hit_policy": "unique",
          "logic": "boolean",
          "limits": {
            "max_terms": 256,
            "max_steps": 1000000
          },
          "rules": [
            {
              "name": "a"
            },
            {
              "name": "b"
            }
          ],
          "checks": [
            {
              "check": "types",
              "status": "complete"
            },
            {
              "check": "fields",
              "status": "not_applicable"
            },
            {
              "check": "unsatisfiable",
              "status": "partial"
            },
            {
              "check": "shadowed",
              "status": "not_applicable"
            },
            {
              "check": "overlap",
              "status": "partial"
            },
            {
              "check": "gap",
              "status": "complete"
            }
          ],
          "not_modelled": [
            {
              "rule": "a",
              "op": "matches",
              "pointer": "/ruleset/rules/0/when"
            },
            {
              "rule": "b",
              "op": "gt",
              "pointer": "/ruleset/rules/1/when"
            }
          ],
          "undecided": [
            {
              "check": "unsatisfiable",
              "rules": [
                "a"
              ],
              "reason": "not_modelled"
            },
            {
              "check": "unsatisfiable",
              "rules": [
                "b"
              ],
              "reason": "not_modelled"
            },
            {
              "check": "overlap",
              "rules": [
                "a",
                "b"
              ],
              "reason": "not_modelled"
            }
          ],
          "diagnostics": [
            {
              "code": "gap",
              "severity": "warning",
              "rules": []
            }
          ]
        }
      }
    },

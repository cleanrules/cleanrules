                    {
                      "op": "or",
                      "operands": [
                        {
                          "op": "eq",
                          "left": {
                            "op": "field",
                            "path": [
                              "y"
                            ]
                          },
                          "right": {
                            "op": "const",
                            "value": 1
                          }
                        },

            },
            {
              "check": "shadowed",
              "status": "complete"
            },
            {
              "check": "overlap",
              "status": "complete"
            },
            {
              "check": "gap",
              "status": "complete"
            }
          ],
          "not_modelled": [],
          "undecided": [],
          "diagnostics": [
            {
              "code": "gap",
              "severity": "warning",
              "rules": []
            }
          ]
        }
      }
    },

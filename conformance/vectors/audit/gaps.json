{
  "version": 1,
  "area": "audit",
  "vectors": [
    {
      "id": "audit/gaps/boundary",
      "spec": [
        "audit.md#gaps",
        "audit.md#witnesses"
      ],
      "description": "under first, no rule fires for age 18: a gap with a witness, as a warning",
      "given": {
        "kind": "audit",
        "document": {
          "version": 1,
          "ruleset": {
            "hit_policy": "first",
            "logic": "boolean",
            "rules": [
              {
                "name": "a",
                "when": {
                  "op": "lt",
                  "left": {
                    "op": "field",
                    "path": [
                      "age"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 18
                  }
                }
              },
              {
                "name": "b",
                "when": {
                  "op": "gt",
                  "left": {
                    "op": "field",
                    "path": [
                      "age"
                    ]
                  },
                  "right": {
                    "op": "const",
                    "value": 18
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "audit": {
          "source": "ruleset",
          "hit_policy": "first",
          "logic": "boolean",
          "limits": {
            "max_terms": 256,
            "max_steps": 1000000
          },
          "rules": [
            {
              "name": "a"
            },
            {
              "name": "b"
            }
          ],
          "checks": [
            {
              "check": "types",
              "status": "complete"
            },
            {
              "check": "fields",
              "status": "not_applicable"
            },
            {
              "check": "unsatisfiable",
              "status": "complete"
            },
            {
              "check": "shadowed",
              "status": "complete"
            },
            {
              "check": "overlap",
              "status": "complete"
            },
            {
              "check": "gap",
              "status": "complete"
            }
          ],
          "not_modelled": [],
          "undecided": [],
          "diagnostics": [
            {
              "code": "gap",
              "severity": "warning",
              "rules": []
            }
          ]
        }
      }
    },

    {
      "id": "ast/types/strict-mismatch",
      "spec": [
        "ast.md#types"
      ],
      "description": "strict mode raises on a type mismatch",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "gt",
          "left": {
            "op": "field",
            "path": [
              "x"

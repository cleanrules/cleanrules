{
  "version": 1,
  "area": "ast",
  "vectors": [
    {
      "id": "ast/types/int-equals-float",
      "spec": [
        "ast.md#types"
      ],
      "description": "ints and floats compare by value",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "eq",
          "left": {
            "op": "field",
            "path": [
              "x"
            ]
          },
          "right": {
            "op": "const",
            "value": 1.0
          }
        },
        "input": {
          "x": 1
        }
      },
      "expect": {
        "result": {
          "op": "eq",
          "truth": true,
          "children": [
            {
              "op": "field",
              "path": [
                "x"
              ],
              "value": 1
            },
            {
              "op": "const",
              "value": 1.0
            }
          ]
        }
      }
    },
    {
      "id": "ast/types/decimal-vs-float",
      "spec": [
        "ast.md#types"
      ],
      "description": "the decimal 0.1 does not equal the float 0.1",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "eq",
          "left": {
            "op": "field",
            "path": [
              "x"
            ]
          },
          "right": {
            "op": "const",
            "value": 0.1
          }
        },
        "input": {
          "x": {
            "$decimal": "0.1"
          }
        }
      },
      "expect": {
        "result": {
          "op": "eq",
          "truth": false,
          "children": [
            {
              "op": "field",
              "path": [
                "x"
              ],
              "value": {
                "$decimal": "0.1"
              }
            },
            {
              "op": "const",
              "value": 0.1
            }
          ]
        }
      }
    },
    {
      "id": "ast/types/decimal-equals-int",
      "spec": [
        "ast.md#types"
      ],
      "description": "a decimal equals an int of the same value",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "eq",
          "left": {
            "op": "field",
            "path": [
              "x"
            ]
          },
          "right": {

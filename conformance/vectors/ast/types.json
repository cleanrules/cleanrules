          }
        }
      },
      "expect": {
        "result": {
          "op": "eq",
          "truth": true,
          "children": [
            {
              "op": "field",
              "path": [
                "x"
              ],
              "value": {
                "$decimal": "2.00"
              }
            },
            {
              "op": "const",
              "value": 2
            }
          ]
        }
      }
    },
    {
      "id": "ast/types/big-int-vs-float",
      "spec": [
        "ast.md#types"
      ],
      "description": "2^53 + 1 does not equal the float 2^53",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "eq",
          "left": {
            "op": "field",
            "path": [
              "x"
            ]
          },
          "right": {
            "op": "const",
            "value": 9007199254740992.0
          }
        },
        "input": {
          "x": {
            "$int": "9007199254740993"
          }
        }
      },
      "expect": {
        "result": {
          "op": "eq",
          "truth": false,
          "children": [
            {
              "op": "field",
              "path": [
                "x"
              ],
              "value": {
                "$int": "9007199254740993"
              }
            },
            {
              "op": "const",
              "value": 9007199254740992.0
            }
          ]
        }
      }
    },
    {
      "id": "ast/types/string-vs-number",
      "spec": [
        "ast.md#types"
      ],
      "description": "comparing a string with a number is a type mismatch",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "gt",
          "left": {
            "op": "field",
            "path": [
              "x"
            ]
          },
          "right": {
            "op": "const",
            "value": 1
          }
        },
        "input": {
          "x": "2"
        }
      },
      "expect": {
        "result": {
          "op": "gt",
          "truth": null,
          "reason": {
            "code": "type_mismatch",
            "paths": [
              [
                "x"
              ]
            ],
            "types": [
              "string",
              "number"
            ]
          },
          "children": [
            {
              "op": "field",
              "path": [
                "x"
              ],
              "value": "2"
            },
            {
              "op": "const",
              "value": 1
            }
          ]
        }
      }
    },
    {
      "id": "ast/types/order-booleans",
      "spec": [
        "ast.md#types"
      ],
      "description": "ordering booleans is unorderable",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "gt",
          "left": {
            "op": "field",
            "path": [
              "x"
            ]
          },
          "right": {
            "op": "const",
            "value": false
          }
        },
        "input": {
          "x": true
        }
      },
      "expect": {
        "result": {
          "op": "gt",
          "truth": null,
          "reason": {
            "code": "unorderable",
            "paths": [
              [
                "x"
              ]
            ],
            "types": [
              "boolean",
              "boolean"
            ]
          },
          "children": [
            {
              "op": "field",
              "path": [
                "x"
              ],
              "value": true
            },
            {
              "op": "const",
              "value": false
            }
          ]
        }
      }
    },

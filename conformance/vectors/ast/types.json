    {
      "id": "ast/types/date-vs-datetime",
      "spec": [
        "ast.md#types"
      ],
      "description": "a date and a datetime are different groups",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "eq",
          "left": {
            "op": "field",
            "path": [
              "x"
            ]
          },
          "right": {
            "op": "const",
            "value": {
              "$date": "2026-10-31"
            }
          }
        },
        "input": {
          "x": {
            "$datetime": "2026-10-31T00:00:00"
          }
        }
      },
      "expect": {
        "result": {
          "op": "eq",
          "truth": null,
          "reason": {
            "code": "type_mismatch",
            "paths": [
              [
                "x"
              ]
            ],
            "types": [
              "naive_datetime",
              "date"
            ]
          },
          "children": [
            {
              "op": "field",
              "path": [
                "x"
              ],
              "value": {
                "$datetime": "2026-10-31T00:00:00"
              }
            },
            {
              "op": "const",
              "value": {
                "$date": "2026-10-31"
              }
            }
          ]
        }
      }
    },
    {
      "id": "ast/types/aware-by-instant",

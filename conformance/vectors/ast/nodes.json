{
  "version": 1,
  "area": "ast",
  "vectors": [
    {
      "id": "ast/nodes/in-true",
      "spec": [
        "ast.md#node-semantics"
      ],
      "description": "in is true when the operand is one of the values",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "in",
          "operand": {
            "op": "field",
            "path": [
              "c"
            ]
          },
          "values": [
            "ES",
            "FR"
          ]
        },
        "input": {
          "c": "ES"
        }
      },
      "expect": {
        "result": {
          "op": "in",
          "truth": true,
          "children": [
            {
              "op": "field",
              "path": [
                "c"
              ],
              "value": "ES"
            }
          ]
        }
      }
    },
    {
      "id": "ast/nodes/in-false",
      "spec": [
        "ast.md#node-semantics"
      ],
      "description": "in is false otherwise",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "in",
          "operand": {
            "op": "field",
            "path": [
              "c"
            ]
          },
          "values": [
            "ES",
            "FR"
          ]
        },
        "input": {
          "c": "PT"
        }
      },
      "expect": {
        "result": {
          "op": "in",
          "truth": false,
          "children": [
            {
              "op": "field",
              "path": [
                "c"
              ],
              "value": "PT"
            }
          ]
        }
      }
    },
    {
      "id": "ast/nodes/in-other-group",
      "spec": [
        "ast.md#node-semantics"
      ],
      "description": "in with an operand of another group is a type mismatch",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "in",
          "operand": {
            "op": "field",
            "path": [
              "c"
            ]
          },
          "values": [
            1,
            2
          ]
        },
        "input": {
          "c": "1"
        }
      },
      "expect": {
        "result": {
          "op": "in",
          "truth": null,
          "reason": {
            "code": "type_mismatch",
            "paths": [
              [
                "c"
              ]
            ],
            "types": [
              "string",
              "number"
            ]
          },
          "children": [
            {
              "op": "field",
              "path": [
                "c"
              ],
              "value": "1"
            }
          ]
        }
      }
    },

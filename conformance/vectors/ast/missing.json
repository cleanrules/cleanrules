      "spec": [
        "ast.md#missing-values",
        "ast.md#evaluating-one-node",
        "json-format.md#result-trees"
      ],
      "description": "a non-boolean field used as a condition is a type mismatch",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "field",
          "path": [
            "age"
          ]
        },
        "input": {
          "age": 3
        }
      },
      "expect": {
        "result": {
          "op": "field",
          "path": [
            "age"
          ],
          "truth": null,
          "reason": {
            "code": "type_mismatch",
            "paths": [
              [
                "age"
              ]
            ],
            "types": [
              "number",
              "boolean"
            ]
          },
          "children": [
            {
              "op": "field",
              "path": [
                "age"
              ],
              "value": 3
            }
          ]
        }
      }

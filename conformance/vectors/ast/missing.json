{
  "version": 1,
  "area": "ast",
  "vectors": [
    {
      "id": "ast/missing/missing-field",
      "spec": [
        "ast.md#missing-values",
        "ast.md#evaluating-one-node",
        "json-format.md#result-trees"
      ],
      "description": "a missing field makes a comparison unknown",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "ge",
          "left": {
            "op": "field",
            "path": [
              "age"
            ]
          },
          "right": {
            "op": "const",
            "value": 18
          }
        },
        "input": {}
      },
      "expect": {
        "result": {
          "op": "ge",
          "truth": null,
          "reason": {
            "code": "missing_field",
            "paths": [
              [
                "age"
              ]
            ]
          },
          "children": [
            {
              "op": "field",
              "path": [
                "age"
              ],
              "value": null,
              "reason": {
                "code": "missing_field",
                "paths": [
                  [
                    "age"
                  ]
                ]
              }
            },
            {
              "op": "const",
              "value": 18
            }
          ]
        }
      }
    },

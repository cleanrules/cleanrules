{
  "version": 1,
  "area": "ast",
  "vectors": [
    {
      "id": "ast/reading/nested-path",
      "spec": [
        "ast.md#reading-data"
      ],
      "description": "a nested path reads through maps",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "eq",
          "left": {
            "op": "field",
            "path": [
              "customer",
              "address",
              "city"
            ]
          },
          "right": {
            "op": "const",
            "value": "Madrid"
          }
        },
        "input": {
          "customer": {
            "address": {
              "city": "Madrid"
            }
          }
        }
      },
      "expect": {
        "result": {
          "op": "eq",
          "truth": true,
          "children": [
            {
              "op": "field",
              "path": [
                "customer",
                "address",
                "city"
              ],
              "value": "Madrid"
            },
            {
              "op": "const",
              "value": "Madrid"
            }
          ]
        }
      }
    },
    {
      "id": "ast/reading/list-index",
      "spec": [
        "ast.md#reading-data"
      ],
      "description": "an integer segment indexes a list",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "gt",
          "left": {
            "op": "field",
            "path": [
              "items",
              1,
              "price"
            ]
          },
          "right": {
            "op": "const",
            "value": 10
          }
        },
        "input": {
          "items": [
            {
              "price": 5
            },
            {
              "price": 20
            }
          ]
        }
      },
      "expect": {
        "result": {
          "op": "gt",
          "truth": true,
          "children": [
            {
              "op": "field",
              "path": [
                "items",
                1,
                "price"
              ],
              "value": 20
            },
            {
              "op": "const",
              "value": 10
            }
          ]
        }
      }
    },
    {
      "id": "ast/reading/index-out-of-range",
      "spec": [
        "ast.md#reading-data"
      ],
      "description": "an index out of range is missing",
      "given": {
        "kind": "condition",
        "condition": {
          "op": "gt",
          "left": {
            "op": "field",
            "path": [
              "items",
              2,
              "price"
            ]
          },
          "right": {
            "op": "const",
            "value": 10
          }
        },
        "input": {
          "items": [
            {
              "price": 5
            }
          ]
        }
      },
      "expect": {
        "result": {
          "op": "gt",
          "truth": null,
          "reason": {
            "code": "missing_field",
            "paths": [
              [
                "items",
                2
              ]
            ]
          },
          "children": [
            {
              "op": "field",
              "path": [
                "items",
                2,
                "price"
              ],
              "value": null,
              "reason": {
                "code": "missing_field",
                "paths": [
                  [
                    "items",
                    2
                  ]
                ]
              }
            },
            {
              "op": "const",
              "value": 10
            }
          ]
        }
      }
    },

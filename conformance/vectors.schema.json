{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanrules.github.io/schemas/conformance/vectors.schema.json",
  "title": "cleanrules conformance vector file, version 1",
  "description": "See conformance/README.md. Documents inside the vectors use the JSON format v1 (spec/json-format.md).",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "required": [
    "version",
    "area",
    "vectors"
  ],
  "additionalProperties": false,
  "$defs": {
    "vector": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(/[a-z0-9-]+){2,}$"
        },
        "spec": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z-]+\\.md#[a-z0-9_-]+$"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "given": {
          "$ref": "#/$defs/given"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        }
      },
      "required": [
        "id",
        "spec",
        "description",
        "given",
        "expect"
      ],
      "additionalProperties": false
    },
    "given": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "read"
            },
            "text": {
              "type": "string"
            },
            "yaml": {
              "type": "string"
            },
            "rules_text": {
              "type": "string",
              "description": "A text in the rule syntax (spec/text.md)."
            },
            "table_csv": {
              "type": "string",
              "description": "A decision table as CSV (spec/tables.md, CSV)."
            },
            "table_grid": {
              "type": "object",
              "description": "A decision table as a grid (spec/tables.md, Grids): the settings as in JSON, a header of texts, and rows whose strings are text and whose other items are values in the JSON encoding (null for an empty cell).",
              "properties": {
                "hit_policy": {
                  "type": "string"
                },
                "aggregate": {
                  "type": "string"
                },
                "logic": {
                  "type": "string"
                },
                "strict": {
                  "type": "boolean"
                },
                "header": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array"
                  }
                }
              },
              "required": [
                "header",
                "rows"
              ],
              "additionalProperties": false
            },
            "document": {
              "type": "object"
            },
            "ruleset": {
              "$ref": "https://cleanrules.github.io/schemas/v1/ruleset.schema.json#/$defs/ruleset"
            },
            "limits": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "max_size",
                  "max_nesting",
                  "max_depth",
                  "max_table_size",
                  "max_path_segments"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "write": {
              "enum": [
                "text",
                "csv"
              ],
              "description": "Write what is read as text (compared with expect.printed) or, for a decision table, as CSV (compared with expect.csv)."
            },
            "current_engine": {
              "const": true,
              "description": "The document is a bundle made by the engine that runs the vector: the runner sets its engine.version, and that of expect.document, to its own engine's version (spec/bundles.md, Contract)."
            }
          },
          "required": [
            "kind"
          ],
          "oneOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "yaml"
              ]
            },
            {
              "required": [
                "rules_text"
              ]
            },
            {
              "required": [
                "table_csv"
              ]
            },
            {
              "required": [
                "table_grid"
              ]
            },
            {
              "required": [
                "document"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "condition"
            },
            "condition": {
              "$ref": "https://cleanrules.github.io/schemas/v1/condition.schema.json#/$defs/condition"
            },
            "input": {
              "$ref": "https://cleanrules.github.io/schemas/v1/value.schema.json#/$defs/value"
            },
            "logic": {
              "description": "A logic in its JSON form (spec/json-format.md, Logics).",
              "$ref": "https://cleanrules.github.io/schemas/v1/logic.schema.json#/$defs/logic"
            },
            "strict": {
              "const": true
            }
          },
          "required": [
            "kind",
            "condition",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "value"
            },
            "value": {
              "$ref": "https://cleanrules.github.io/schemas/v1/rule.schema.json#/$defs/payloadValue"
            },
            "input": {
              "$ref": "https://cleanrules.github.io/schemas/v1/value.schema.json#/$defs/value"
            },
            "strict": {
              "const": true
            }
          },
          "required": [
            "kind",
            "value",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "evaluate"
            },
            "ruleset": {
              "$ref": "https://cleanrules.github.io/schemas/v1/ruleset.schema.json#/$defs/ruleset"
            },
            "input": {
              "$ref": "https://cleanrules.github.io/schemas/v1/value.schema.json#/$defs/value"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "https://cleanrules.github.io/schemas/v1/value.schema.json#/$defs/value"
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_values": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "max_values"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "ruleset"
          ],
          "oneOf": [
            {
              "required": [
                "input"
              ]
            },
            {
              "required": [
                "inputs"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "explain"
            },
            "ruleset": {
              "$ref": "https://cleanrules.github.io/schemas/v1/ruleset.schema.json#/$defs/ruleset"
            },
            "input": {
              "$ref": "https://cleanrules.github.io/schemas/v1/value.schema.json#/$defs/value"
            }
          },
          "required": [
            "kind",
            "ruleset",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "summary"
            },
            "ruleset": {
              "$ref": "https://cleanrules.github.io/schemas/v1/ruleset.schema.json#/$defs/ruleset"
            }
          },
          "required": [
            "kind",
            "ruleset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A tool call on a catalog of named rule sets (spec/agents.md).",
          "properties": {
            "kind": {
              "const": "tool"
            },
            "rulesets": {
              "type": "object",
              "description": "The catalog: each rule set's name and the content of its rule set document.",
              "additionalProperties": {
                "$ref": "https://cleanrules.github.io/schemas/v1/ruleset.schema.json#/$defs/ruleset"
              }
            },
            "tool": {
              "type": "string"
            },
            "arguments": {
              "description": "The call's arguments, as JSON."
            },
            "arguments_text": {
              "type": "string",
              "description": "The call's arguments as JSON text, for texts a vector cannot hold as JSON (syntax errors, repeated keys)."
            }
          },
          "required": [
            "kind",
            "tool"
          ],
          "oneOf": [
            {
              "required": [
                "arguments"
              ]
            },
            {
              "required": [
                "arguments_text"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Read a condition, rule, rule set or decision table document and give its canonical bytes and digest (spec/json-format.md, Canonical bytes, Digests).",
          "properties": {
            "kind": {
              "const": "canonical"
            },
            "document": {
              "type": "object",
              "description": "A condition, rule, rule set or decision table document."
            },
            "text": {
              "type": "string",
              "description": "The document as JSON text, for lexical cases."
            }
          },
          "required": [
            "kind"
          ],
          "oneOf": [
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "text"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Draw a diagram (spec/visual.md): of the document, or, with an input, of the explanation of a rule set's decision or of a decision table's grid with the statuses of its rows.",
          "properties": {
            "kind": {
              "const": "draw"
            },
            "format": {
              "enum": [
                "dot",
                "mermaid",
                "html",
                "html_fragment"
              ]
            },
            "document": {
              "type": "object",
              "description": "A condition, rule, rule set or decision table document (spec/json-format.md)."
            },
            "input": {
              "$ref": "https://cleanrules.github.io/schemas/v1/value.schema.json#/$defs/value",
              "description": "Only with a rule set or a decision table."
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_diagram_size": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "max_diagram_size"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "format",
            "document"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Make a bundle (spec/bundles.md, Making a bundle), write it and read it back.",
          "properties": {
            "kind": {
              "const": "bundle"
            },
            "document": {
              "type": "object",
              "description": "A rule set or decision table document: the rules."
            },
            "id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "cases": {
              "type": "array",
              "description": "The case files: each path, and the file's content as UTF-8 text.",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "limits": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "max_size",
                  "max_nesting",
                  "max_depth",
                  "max_path_segments",
                  "max_table_size",
                  "max_values"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "kind",
            "document",
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Read two bundles and compare the first with the second (spec/bundles.md, Comparing bundles).",
          "properties": {
            "kind": {
              "const": "bundle_compare"
            },
            "a": {
              "$ref": "https://cleanrules.github.io/schemas/v1/bundle.schema.json"
            },
            "b": {
              "$ref": "https://cleanrules.github.io/schemas/v1/bundle.schema.json"
            }
          },
          "required": [
            "kind",
            "a",
            "b"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Audit a rule set or decision table (spec/audit.md).",
          "properties": {
            "kind": {
              "const": "audit"
            },
            "document": {
              "type": "object",
              "description": "A rule set or decision table document (spec/json-format.md)."
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_terms": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_steps": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "ruleset_digest": {
              "const": true,
              "description": "Ask for the rule set digest in the report (spec/audit.md, JSON)."
            }
          },
          "required": [
            "kind",
            "document"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Run test cases against rules (spec/tests.md, Running cases).",
          "properties": {
            "kind": {
              "const": "test_run"
            },
            "document": {
              "type": "object",
              "description": "The rules: a rule set, decision table or bundle document (spec/json-format.md)."
            },
            "cases": {
              "type": "object",
              "description": "A case file document, run without a path."
            },
            "files": {
              "type": "array",
              "description": "Case files with their paths and contents as UTF-8 text, in order; for a bundle, the files it names, by path.",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_results": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_steps": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_explained": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "cancel_after": {
              "type": "integer",
              "minimum": 0,
              "description": "Cancel the run by a callback that says so when it is asked after this many results (spec/tests.md, Batches and interruption)."
            },
            "ruleset_digest": {
              "const": true,
              "description": "Ask for the rule set digest in the test run (spec/tests.md, Test runs)."
            }
          },
          "required": [
            "kind",
            "document"
          ],
          "oneOf": [
            {
              "required": [
                "cases"
              ]
            },
            {
              "required": [
                "files"
              ]
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "document": {
          "type": "object"
        },
        "result": {
          "$ref": "https://cleanrules.github.io/schemas/v1/decision.schema.json#/$defs/result"
        },
        "decision": {
          "$ref": "https://cleanrules.github.io/schemas/v1/decision.schema.json#/$defs/decision"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "https://cleanrules.github.io/schemas/v1/decision.schema.json#/$defs/decision"
          }
        },
        "explanation": {
          "$ref": "https://cleanrules.github.io/schemas/v1/explanation.schema.json#/$defs/explanation"
        },
        "summary": {
          "$ref": "https://cleanrules.github.io/schemas/v1/summary.schema.json#/$defs/summary"
        },
        "text": {
          "type": "string"
        },
        "printed": {
          "type": "string",
          "description": "The canonical text (spec/text.md, Printing)."
        },
        "csv": {
          "type": "string",
          "description": "The canonical CSV of a decision table (spec/tables.md, CSV)."
        },
        "compiled": {
          "$ref": "https://cleanrules.github.io/schemas/v1/ruleset.schema.json#/$defs/ruleset",
          "description": "The rule set a decision table compiles into (spec/tables.md, Compiling)."
        },
        "output": {
          "type": "object",
          "description": "A tool's result (spec/agents.md, Results), with the error of a validate result written without its free text (conformance/README.md, Comparing)."
        },
        "canonical": {
          "type": "string",
          "description": "The canonical bytes of a document, as UTF-8 text compared exactly (spec/json-format.md, Canonical bytes)."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The document's digest (spec/json-format.md, Digests)."
        },
        "ruleset_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The rule set digest of the rule set the document gives (spec/json-format.md, Rule set digests): none for a condition."
        },
        "diagram": {
          "type": "string",
          "description": "The exact text of a diagram (spec/visual.md)."
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "format_error",
                "unsupported_version",
                "limit_exceeded",
                "decision_mismatch",
                "expression_error",
                "rule_definition_error",
                "rule_syntax_error",
                "registry_error",
                "rule_not_found",
                "evaluation_error",
                "missing_field",
                "type_mismatch",
                "hit_policy_error",
                "action_error",
                "unsupported"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            },
            "rule": {
              "type": "string"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "executed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "name": {
              "type": "string"
            },
            "available": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        "comparison": {
          "$ref": "https://cleanrules.github.io/schemas/v1/bundle.schema.json#/$defs/comparison",
          "description": "The comparison of two bundles (spec/bundles.md, Comparing bundles)."
        },
        "audit": {
          "type": "object",
          "description": "The audit (spec/audit.md, JSON) without the message and witness of each diagnostic, which the runner checks instead (conformance/README.md)."
        },
        "test_run": {
          "type": "object",
          "description": "The test run (spec/tests.md, Test runs), with each error written with its code and compared fields only, which the runner compares as errors are (conformance/README.md, Comparing)."
        }
      },
      "additionalProperties": false
    }
  }
}

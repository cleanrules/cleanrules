{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run maturin develop *)",
      "Bash(uv run maturin build *)",
      "Bash(uv run mkdocs build *)",
      "Bash(uv run python benchmarks/*)",
      "Bash(uvx ruff *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo bench *)",
      "Bash(cargo nextest *)",
      "Bash(cargo doc *)",
      "Bash(cargo run *)",
      "Bash(cargo tree *)",
      "Bash(cargo deny *)",
      "Bash(cargo llvm-cov *)",
      "Bash(cargo miri *)",
      "Bash(cbindgen *)",
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npm ci *)",
      "Bash(npm --prefix bindings/js test *)",
      "Bash(npm --prefix bindings/js run *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew check *)",
      "Bash(sbt test *)",
      "Bash(sbt compile *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv pip install *)",
      "Bash(pip install *)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(go get *)",
      "Bash(go mod tidy *)"
    ],
    "deny": [
      "Bash(uv publish *)",
      "Bash(maturin publish *)",
      "Bash(uv run maturin publish *)",
      "Bash(twine upload *)",
      "Bash(cargo publish *)",
      "Bash(npm publish *)",
      "Bash(./gradlew publish *)",
      "Bash(sbt publish *)",
      "Bash(sbt publishSigned *)",
      "Bash(conan upload *)",
      "Bash(gh release create *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run maturin develop *)",
      "Bash(uv run mkdocs build *)",
      "Bash(uv run python benchmarks/*)",
      "Bash(uvx ruff *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo bench *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(cargo add *)"
    ],
    "deny": [
      "Bash(uv publish *)",
      "Bash(maturin publish *)",
      "Bash(uv run maturin publish *)",
      "Bash(twine upload *)",
      "Bash(cargo publish *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}
